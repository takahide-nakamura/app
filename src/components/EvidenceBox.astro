---
interface Props {
  title?: string;
  type?:
    | "subjective"
    | "objective"
    | "limitation";
}

const {
  title,
  type = "objective"
} = Astro.props;

const styles = {
  subjective: {
    color: "var(--color-success)"
  },
  objective: {
    color: "var(--color-party-primary)"
  },
  limitation: {
    color: "var(--color-text-subtle)"
  },

} as const;

const current = styles[type] ?? styles.objective;
---

<aside
  class="evidence-box"
  role="note"
  style={`--accent:${current.color}`}
>

  {
    title && (
      <h3>{title}</h3>
    )
  }

  <div class="content">
    <slot />
  </div>

</aside>

<style>

.evidence-box{

  border-left:6px solid var(--accent);

  background:var(--color-party-primary-subtle);

  padding:1.5rem 1.5rem;

  margin:1.75rem 0;

  border-radius: var(--radius);

}

.evidence-box h3{

  margin:0 0 1rem;

  color:var(--accent);

}

.content{

  line-height:1.85;

}

.content p:first-child{

  margin-top:0;

}

.content p:last-child{

  margin-bottom:0;

}

</style>