---
interface Props {
  title?: string;
  type?:
    | "subjective"
    | "objective"
    | "limitation"
    | "field"
    | "official"
    | "reason"
    | "improvement"
    | "effect";
}

const {
  title,
  type = "objective"
} = Astro.props;

const styles = {
  subjective: {
    color: "#2e8b57"
  },
  objective: {
    color: "#003f88"
  },
  limitation: {
    color: "#666666"
  },

  // 後方互換
  field: {
    color: "#2e8b57"
  },
  official: {
    color: "#003f88"
  },
  reason: {
    color: "#8e44ad"
  },
  improvement: {
    color: "#f39c12"
  },
  effect: {
    color: "#4caf50"
  }
} as const;

const current = styles[type] ?? styles.objective;
---

<aside
  class="evidence-box"
  role="note"
  style={`--accent:${current.color}`}
>

  {
    title && (
      <h3>{title}</h3>
    )
  }

  <div class="content">
    <slot />
  </div>

</aside>

<style>

.evidence-box{

  border-left:6px solid var(--accent);

  background:#f8fbff;

  padding:1.5rem 1.5rem;

  margin:1.75rem 0;

  border-radius:10px;

}

.evidence-box h3{

  margin:0 0 1rem;

  color:var(--accent);

}

.content{

  line-height:1.85;

}

.content p:first-child{

  margin-top:0;

}

.content p:last-child{

  margin-bottom:0;

}

</style>