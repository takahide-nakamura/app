---
import { getBaseUrl } from "../lib/siteUrl";

const base = getBaseUrl();
import { politicalAffiliation } from "../data/politicalAffiliation";
---
<header class="site-header">
  <div class="header-inner container">
    <div class="brand-group">
      <div class="identity-row">
        <span class="author-name">中村たかひで</span>
        {politicalAffiliation.enabled && (
          <span class="party-affiliation">{politicalAffiliation.displayName}</span>
        )}
      </div>
      <a href={`${base}`} class="brand-link" aria-label="もっと住みやすい高槻へ ホーム">もっと住みやすい高槻へ</a>
      <p class="tagline">
        事実に向き合い、市民の皆さんとの対話を重ね、<br class="pc-br" />
        もっと住みやすい高槻をつくる。
      </p>
    </div>

    <div class="header-right-group">
        <nav class="global-nav" aria-label="主要ナビゲーション">
          <a href={`${base}`}>ホーム</a>
          <a href={`${base}policy/`}>政策</a>
          <a href={`${base}activity/`}>活動</a>
          <a href={`${base}profile/`}>プロフィール</a>
          <a href={`${base}opinions/`}>市民の声</a>
          <a
            href={`${base}contact/`}
            onclick="gtag('event', 'click_contact', { link_location: 'header' })"
          >
            お問い合わせ
          </a>
       </nav>

      {politicalAffiliation.enabled && (
        <a
          class="party-logo-link"
          href={politicalAffiliation.officialUrl || `${base}`}
          target={politicalAffiliation.officialUrl ? "_blank" : undefined}
          rel={politicalAffiliation.officialUrl ? "noopener noreferrer" : undefined}
          aria-label={politicalAffiliation.logoAlt}
        >
          <img
            src={`${base}${politicalAffiliation.logoSrc.replace(/^\//, '')}`}
            alt={politicalAffiliation.logoAlt}
            class="party-logo"
          />
       </a>
     )}
    </div>
  </div>
</header>

<style>
.site-header {
  background: #fff;
  border-bottom: 1px solid #e5e7eb;
}

.header-inner {
  padding-top: 1rem;
  padding-bottom: 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: nowrap; /* デスクトップでは強制的に折り返しを防止 */
}

.brand-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex-shrink: 1;
}

.brand-link {
  color: var(--color-primary);
  font-size: 1.35rem;
  font-weight: 700;
  text-decoration: none;
  line-height: 1.2;
  margin-top: 0.15rem;
  white-space: nowrap;
}

.brand-link:hover {
  text-decoration: none;
}

.identity-row {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0.5rem;
}

/* 名前（中村たかひで）：すっきりした可読性を確保 */
.author-name {
  display: inline-block;
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--color-personal-brand);
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.party-affiliation {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 600;
  color: #374151;
  white-space: nowrap;
}

.tagline {
  margin: 0.25rem 0 0;
  font-size: 0.82rem;
  color: #4b5563;
  line-height: 1.4;
}

/* 政党ロゴ：右側に潰れず・落ちずに固定配置 */
.party-logo-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.party-logo {
  display: block;
  max-height: 48px;
  width: auto;
  max-width: 120px;
  object-fit: contain;
}
.header-right-group {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-shrink: 0;
}
.global-nav {
  display: flex;
  gap: 1rem;
  align-items: center;
  flex-shrink: 0;
}

.global-nav a {
  color: #333;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  letter-spacing: 0.02em;
  transition: color 0.2s;
  white-space: nowrap;
}

.global-nav a:hover {
  color: var(--color-primary);
}

.pc-br {
  display: none;
}

@media (min-width: 1024px) {
  .pc-br {
    display: inline;
  }
}

/* モバイル・レスポンシブ調整 */
@media (max-width: 1023px) {
  .header-inner {
    flex-wrap: wrap;
    justify-content: center;
  }

  .brand-group {
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .brand-link {
    font-size: 1.25rem;
  }

  .global-nav {
    justify-content: center;
    gap: 0.6rem 0.9rem;
  }

  .party-logo {
    max-height: 40px;
  }
}
</style>