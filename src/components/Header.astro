---
// Astro組み込みのベースURL（astro.config.mjs の base: '/app' を参照）
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
import SocialLinks from "./SocialLinks.astro";
import { politicalAffiliation } from "../data/politicalAffiliation";
---
<header class="site-header">
  <div class="header-inner container">
    <div class="brand-group">
      <div class="identity-row">
        <span class="author-name">中村たかひで</span>
        {politicalAffiliation.enabled && (
          <span class="party-affiliation">{politicalAffiliation.displayName}</span>
        )}
      </div>
      <a href={`${baseUrl}`} class="brand-link" aria-label="もっと住みやすい高槻へ ホーム">もっと住みやすい高槻へ</a>
      <p class="tagline">
        事実に向き合い、市民の皆さんとの対話を重ね、<br class="pc-br" />
        もっと住みやすい高槻をつくる。
      </p>
    </div>


    <nav class="global-nav" aria-label="主要ナビゲーション">
      <a href={`${base}`}>ホーム</a>
      <a href={`${base}policy/`}>政策</a>
      <a href={`${base}activity/`}>活動</a>
      <a href={`${base}profile/`}>プロフィール</a>
      <a href={`${base}opinions/`}>市民の声</a>
      <a href={`${base}contact/`}>お問い合わせ</a>
    </nav>
        {politicalAffiliation.enabled && (
      <a class="party-logo-link" href={politicalAffiliation.officialUrl || `${base}`} target={politicalAffiliation.officialUrl ? "_blank" : undefined} rel={politicalAffiliation.officialUrl ? "noopener noreferrer" : undefined} aria-label={politicalAffiliation.logoAlt}>
        <img src={politicalAffiliation.logoSrc} alt={politicalAffiliation.logoAlt} class="party-logo" />
      </a>
    )}

    <SocialLinks />
  </div>
</header>

<style>
.site-header {
  background: #fff;
  border-bottom: 1px solid #e5e7eb;
}

.header-inner {
  padding-top: 1.2rem;
  padding-bottom: 1.2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
}

.brand-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-link {
  color: var(--color-primary);
  font-size: 1.5rem;
  font-weight: 700;
  text-decoration: none;
  line-height: 1.2;
  margin-top: 0.2rem;
}

.brand-link:hover {
  text-decoration: none;
}

.identity-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  margin-top: 0.25rem;
}

.author-name {
  display: inline-block;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-personal-brand);
}

.party-affiliation {
  display: inline-block;
  font-size: 0.82rem;
  font-weight: 600;
  color: #374151;
}

.tagline {
  margin: 0.35rem 0 0;
  font-size: 0.9rem;
  color: #4b5563;
  line-height: 1.5;
}

.party-logo-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120px;
}

.party-logo {
  display: block;
  max-height: 56px;
  width: auto;
  max-width: 140px;
  object-fit: contain;
}

.global-nav {
  display: flex;
  gap: 1.5rem;
  align-items: center;
  flex-wrap: wrap;
}

.global-nav a {
  color: #333;
  text-decoration: none;
  font-weight: 500;
  letter-spacing: 0.05em;
  transition: color 0.2s;
}

.global-nav a:hover {
  color: var(--color-primary);
}

@media (max-width: 768px) {
  .site-header {
    padding-top: 0.2rem;
  }

  .header-inner {
    flex-direction: column;
    align-items: center;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
    gap: 0.8rem;
  }

  .brand-group {
    align-items: center;
    text-align: center;
  }

  .identity-row {
    justify-content: center;
    gap: 0.5rem 0.75rem;
  }

  .brand-link {
    font-size: 1.28rem;
  }

  .global-nav {
    justify-content: center;
    gap: 0.65rem 1rem;
  }

  .party-logo-link {
    min-width: 0;
  }

  .party-logo {
    max-height: 44px;
    max-width: 120px;
  }
}
</style>