---
// Astro組み込みのベースURL（astro.config.mjs の base: '/app' を参照）
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
import SocialLinks from "./SocialLinks.astro";
---
<header class="site-header">
  <div class="header-inner container">
    <div class="brand">
      <span class="author-name">中村たかひで</span>
      <a href={`${baseUrl}`} class="logo">もっと住みやすい高槻へ</a>
      <p class="tagline">
        事実に向き合い、市民の皆さんとの対話を重ね、<br class="pc-br" />
        もっと住みやすい高槻をつくる。
      </p>
    </div>

    <nav class="global-nav">
      <a href={`${base}`}>ホーム</a>
      <a href={`${base}policy/`}>政策</a>
      <a href={`${base}activity/`}>活動</a>
      <a href={`${base}profile/`}>プロフィール</a>
      <a href={`${base}opinions/`}>市民の声</a>
      <a href={`${base}contact/`}>お問い合わせ</a>
    </nav>
    <SocialLinks />
  </div>
</header>

<style>
.site-header {
  background: #fff;
  border-bottom: 1px solid #e5e7eb;
}

.header-inner {
  padding-top: 1.2rem;
  padding-bottom: 1.2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
}

.brand {
  display: flex;
  flex-direction: column;
}

.logo {
  color: #003f88;
  font-size: 1.6rem;
  font-weight: 700;
  text-decoration: none;
  line-height: 1.2;
}

.logo:hover {
  text-decoration: none;
}

.tagline {
  margin: 0.35rem 0 0;
  font-size: 0.9rem;
  color: #4b5563;
  line-height: 1.5;
}

.author-name {
  display: block;
  font-size: 0.95rem;
  font-weight: 600;
  color: #374151;
  margin-bottom: 0.1rem;
}

.global-nav {
  display: flex;
  gap: 2rem;
  align-items: center;
}

.global-nav a {
  color: #333;
  text-decoration: none;
  font-weight: 500;
  letter-spacing: 0.05em;
  transition: color 0.2s;
}

.global-nav a:hover {
  color: #003f88;
}

@media (max-width: 768px) {
  .header-inner {
    flex-direction: column;
    align-items: center;
  }

  .brand {
    align-items: center;
    text-align: center;
  }

  .global-nav {
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
}
</style>