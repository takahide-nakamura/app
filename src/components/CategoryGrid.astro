---
const categories = [
  {
    title: "🏥 医療・介護",
    description: "医療・介護・福祉に関する政策"
  },
  {
    title: "👶 子育て",
    description: "子育て・教育に関する政策"
  },
  {
    title: "🛡️ 防災・安全",
    description: "防災・防犯・安全に関する政策"
  },
  {
    title: "🏙️ まちづくり・交通",
    description: "道路・公園・交通などの政策"
  },
  {
    title: "🤝 地域・くらし",
    description: "地域活動・行政サービス・暮らしの政策"
  }
];
---

<section class="category-grid">

  <h2>カテゴリーから探す</h2>

  <div class="grid">

    {
      categories.map((category) => (

        <a
          href="/policy"
          class="card"
        >
          <h3>{category.title}</h3>

          <p>{category.description}</p>

        </a>

      ))
    }

  </div>

</section>

<style>

.category-grid{
  margin:var(--space-xl) auto;
}

.category-grid h2{
  text-align:center;
  color:var(--color-primary);
  margin-bottom:2rem;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:1.5rem;
}

.card{
  display:block;
  text-decoration:none;
  color:inherit;

  border:1px solid var(--color-border);
  border-radius:var(--radius);

  padding:1.5rem;

  transition:.2s;
}

.card:hover{
  transform:translateY(-3px);
  border-color:var(--color-primary);
}

.card h3{
  margin-top:0;
  color:var(--color-primary);
}

.card p{
  margin-bottom:0;
}

</style>