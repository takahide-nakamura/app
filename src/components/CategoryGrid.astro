---
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;

const categories = [
  {
    title: "🏥 医療・介護",
    slug: "medical-care",
    description: "医療・介護・福祉に関する政策"
  },
  {
    title: "👨‍👩‍👧 子育て",
    slug: "childcare",
    description: "子育て・教育に関する政策"
  },
  {
    title: "🛡️ 防災",
    slug: "disaster-prevention",
    description: "防災・防犯・安全に関する政策"
  },
  {
    title: "🏙️ 暮らし",
    slug: "living",
    description: "道路・公園・交通などの政策"
  },
];
---

<section class="category-grid container">
  <h2>カテゴリーから探す</h2>

  <div class="category-cards">
    {
      categories.map((category) => (
        <a href={`${base}policy/#${category.slug}`} class="card-item">
          <h3>{category.title}</h3>
          <p>{category.description}</p>
        </a>
      ))
    }
  </div>
</section>

<style>
.category-grid {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

.category-grid h2 {
  text-align: center;
  color: var(--color-primary);
  margin-bottom: 2rem;
}

.category-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
}

.card-item {
  display: flex;
  flex-direction: column;
  color: inherit;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: var(--radius, 12px);
  padding: 1.5rem;
  background: #ffffff;
  box-sizing: border-box;
  height: 100%; /* 横並び時の高さを自動整列 */
}

.card-item h3 {
  margin-top: 0;
  margin-bottom: 0.5rem;
  color: var(--color-primary);
  font-size: 1.1rem;
}

.card-item p {
  margin-bottom: 0;
  color: #4b5563;
  font-size: 0.9rem;
  line-height: 1.5;
  flex-grow: 1; /* テキスト領域を広げて下部余白を自動で埋める */
}
</style>