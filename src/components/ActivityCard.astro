---
interface Props {
  title: string;
  description: string;
  items?: string[];
}

const {
  title,
  description,
  items = []
} = Astro.props;
---

<article class="activity-card">

  <h2>{title}</h2>

  <p>
    {description}
  </p>

  {items.length > 0 && (
  <ul class="activity-list">
    {items.map(item => (
      <li>{item}</li>
    ))}
  </ul>
  )}

</article>

<style>
.activity-card{
  border:1px solid var(--color-border);
  border-radius:var(--radius-lg);
  background:#fff;
  padding:2rem;
  margin-bottom:2rem;
}

.activity-card h2{
  color:var(--color-party-primary);
  margin-top:0;
}

.activity-card p{
  line-height:1.8;
}

.activity-list{
  margin-top:1.5rem;
  padding-left:1.25rem;
  line-height:1.9;
}

.activity-list li{
  margin-bottom:.4rem;
}

</style>