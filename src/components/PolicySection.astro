---
interface Props {
  title: string;
  icon?: string;
}

const {
  title,
  icon
} = Astro.props;
---

<section class="policy-section">

  <h2 class="section-title">

    {
      icon && (
        <span
          class="section-icon"
          aria-hidden="true"
        >
          {icon}
        </span>
      )
    }

    <span>{title}</span>

  </h2>

  <div class="section-content">
    <slot />
  </div>

</section>

<style>
.policy-section {
  margin: 0 0 2.5rem;
  padding: 0;
}

.policy-section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;

  margin: 0 0 1.25rem 0;
  padding: 0;

  color: var(--color-primary, #003f88);

  font-size: 1.35rem;
  line-height: 1.4;
  border-bottom: 2px solid var(--color-border, #e5e7eb);
}

.section-icon {
  flex-shrink: 0;
}

.section-content {
  line-height: 1.8;
  padding: 0;
}

/* 内部に挿入される全要素の余白調整 */
:global(.section-content > *),
:global(.section-content div),
:global(.section-content article),
:global(.related-activities),
:global(.activity-card) {
  padding-top: 0;
  padding-bottom: 0;
}

/* 提案などの内部section（h3箇条書きブロック）のレイアウト調整 */
:global(.section-content section) {
  margin-bottom: 1rem;
  padding: 1rem 1.25rem;
  background-color: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
}

:global(.section-content section:last-child) {
  margin-bottom: 0;
}

/* h3の見出し余白 */
:global(.section-content h3) {
  margin: 0 0 1rem 0;
  padding: 0;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-primary, #003f88);
}

/* 箇条書きリスト（ul / li）の余白と行間 */
:global(.section-content ul),
:global(.proposal-list) {
  margin: 0 0 1.25rem 1.25rem;
  padding-left: 1.25rem;
}

:global(.section-content li) {
  margin-bottom: 0.75rem;
  line-height: 1.75;
  font-size: 0.98rem;
}

:global(.section-content li:last-child) {
  margin-bottom: 0;
}

@media (min-width: 768px) {
  .policy-section {
    margin-bottom: 36px;
  }

  .section-title {
    font-size: 1.45rem;
  }
}
</style>