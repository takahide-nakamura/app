---
interface Props {
  title: string;
  icon?: string;
}

const {
  title,
  icon
} = Astro.props;
---

<section class="policy-section">

  <h2 class="section-title">

    {
      icon && (
        <span
          class="section-icon"
          aria-hidden="true"
        >
          {icon}
        </span>
      )
    }

    <span>{title}</span>

  </h2>

  <div class="section-content">
    <slot />
  </div>

</section>

<style>
.policy-section + .policy-section{
  margin-bottom: var(--space-xl);
}

.section-title{
  display:flex;
  align-items:center;
  gap:.5rem;

  margin:0 0 1.25rem;

  color:var(--color-primary);

  font-size:1.5rem;
  line-height:1.4;
}

.section-icon{
  flex-shrink:0;
}

.section-content{
  line-height:1.9;
}

.section-content p:first-child{
  margin-top:0;
}

.section-content p:last-child{
  margin-bottom:0;
}
</style>