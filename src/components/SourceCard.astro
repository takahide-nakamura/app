---
interface Props {
  title: string;
  publisher: string;
  year?: string;
  checked?: string;
  evidenceLevel?: string;
  url?: string;
}

const {
  title,
  publisher,
  year,
  checked,
  evidenceLevel,
  url
} = Astro.props;
---

<article class="source-card">

  <h3>{title}</h3>

  <dl class="source-info">

    <div>
      <dt>発行主体</dt>
      <dd>{publisher}</dd>
    </div>

    {
      year && (
        <div>
          <dt>発行年</dt>
          <dd>{year}</dd>
        </div>
      )
    }

    {
      checked && (
        <div>
          <dt>最終確認日</dt>
          <dd>{checked}</dd>
        </div>
      )
    }

    {
      evidenceLevel && (
        <div>
          <dt>エビデンス</dt>
          <dd>{evidenceLevel}</dd>
        </div>
      )
    }

  </dl>

  {
    url ? (
      <p class="link">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
        >
          資料を見る（新しいタブで開きます）
        </a>
      </p>
    ) : (
      <p class="unavailable">
        資料URLは現在公開されていません。
      </p>
    )
  }

</article>

<style>

.source-card{

  border:1px solid #ddd;

  border-radius:12px;

  padding:1.25rem;

  margin-bottom:1rem;

  background:#fff;

}

.source-card h3{

  margin:0 0 1rem;

  color:var(--color-primary);

  font-size:1.05rem;

}

.source-info{

  margin:0;

}

.source-info div{

  display:flex;

  margin-bottom:.5rem;

}

.source-info dt{

  width:7rem;

  flex-shrink:0;

  font-weight:700;

  color:#666;

}

.source-info dd{

  margin:0;

}

.link{

  margin-top:1rem;

}

.link a{

  color:var(--color-primary);

  text-decoration:none;

  font-weight:600;

}

.link a:hover{

  text-decoration:underline;

}

.unavailable{

  margin-top:1rem;

  color:#666;

  font-size:.95rem;

}

</style>