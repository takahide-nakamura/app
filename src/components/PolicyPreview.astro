---
import PolicyPreviewCard from "./PolicyPreviewCard.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<section class="policy-preview container">
  <h2>重点政策</h2>

  <p class="lead">
    市民の皆さんの声と事実に基づき、<br class="pc-br" />
    優先して取り組みたい政策です。
  </p>

  <div class="cards">

    <PolicyPreviewCard
       emoji="🏥"
       title="医療・介護"
       description="現場経験を活かし、医療・介護サービスの充実と安心して暮らせる地域づくりを目指します。"
    />

    <PolicyPreviewCard
       emoji="👨‍👩‍👧"
       title="子育て"
       description="市民の皆さんの声や公開データをもとに、子育てしやすい環境づくりを考えます。"
    />

    <PolicyPreviewCard
       emoji="🏙️"
       title="暮らし"
       description="暮らしやすさを第一に、地域課題を一つずつ改善していきます。"
    />

  </div>

  <p class="more">
    <a href={`${baseUrl}policy/`} class="btn btn-primary">
      政策一覧を見る
    </a>
  </p>

</section>

<style>
.policy-preview {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

.policy-preview h2 {
  text-align: center;
}

.lead {
  text-align: center;
  margin-bottom: 2rem;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}

.more {
  text-align: center;
  margin-top: 2rem;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}
</style>