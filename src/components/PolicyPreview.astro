---
import PolicyPreviewCard from "./PolicyPreviewCard.astro";

import { getBaseUrl } from "../lib/siteUrl";

const base = getBaseUrl();
---

<section class="policy-preview container">
  <h2>分野から政策を探す</h2>

  <p class="lead">
    政策を4つの分野に分けて紹介しています。<br class="pc-br" />
    分野を選ぶと、その分野の政策一覧へ移動します。
  </p>

  <div class="cards">

    <PolicyPreviewCard
       emoji="🏥"
       title="医療・介護"
       description="医療・介護の現場経験をもとに、安心して必要な支援を受けられる仕組みを考えます。"
       href={`${base}policy/#medical-care`}
    />

    <PolicyPreviewCard
       emoji="👨‍👩‍👧"
       title="子育て"
       description="今は共働きの時代。共働きでも子育てしやすい環境づくりを考えます。"
       href={`${base}policy/#childcare`}
    />
    <PolicyPreviewCard
       emoji="🛡️"
       title="防災"
       description="もしもの際に、ひとりでも多くの命を救い、生活再建を少しでも早く。一つずつ考えていきます。"
       href={`${base}policy/#disaster-prevention`}
    />
    <PolicyPreviewCard
       emoji="🏙️"
       title="暮らし"
       description="暮らしやすさは住みやすさ。地域課題を一つずつ取り上げ、改善を提案していきます。"
       href={`${base}policy/#living`}
    />

  </div>

  <p class="more">
    <a href={`${base}policy/`} class="btn btn-primary">
      政策一覧を見る
    </a>
  </p>

</section>

<style>
.policy-preview {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

.policy-preview h2 {
  text-align: center;
  color: var(--color-primary);
}

.lead {
  text-align: center;
  margin-bottom: 2rem;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  gap: 1.5rem;
}

.more {
  text-align: center;
  margin-top: 2rem;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}
</style>