---
import PolicyPreviewCard from "./PolicyPreviewCard.astro";
---

<section class="policy-preview">
  <h2>重点政策</h2>

  <p class="lead">
    市民の皆さんの声と事実に基づき、
    優先して取り組みたい政策です。
  </p>

  <div class="cards">

    <PolicyPreviewCard
       emoji="🏥"
       title="医療・介護"
       description="現場経験を活かし、医療・介護サービスの充実と安心して暮らせる地域づくりを目指します。"
    />

    <PolicyPreviewCard
       emoji="👨‍👩‍👧"
       title="子育て"
       description="市民の皆さんの声や公開データをもとに、子育てしやすい環境づくりを考えます。"
    />

    <PolicyPreviewCard
       emoji="🏙️"
       title="暮らし"
       description="暮らしやすさを第一に、地域課題を一つずつ改善していきます。"
    />

  </div>

  <p class="more">
    <a href="/policy" class="btn btn-primary">
      政策一覧を見る
    </a>
  </p>

</section>

<style>
.policy-preview{
  max-width:1100px;
  margin:6rem auto;
}

.policy-preview h2{
  text-align:center;
}

.lead{
  text-align:center;
  margin-bottom:3rem;
}

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:1.5rem;
}

.card{
  border:1px solid #ddd;
  border-radius:16px;
  padding:1.5rem;
  background:#fff;
}

.card h3{
  margin-top:0;
}

.more{
  text-align:center;
  margin-top:2rem;
}
</style>