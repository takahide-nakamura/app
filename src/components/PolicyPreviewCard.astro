---
interface Props {
  emoji: string;
  title: string;
  description: string;
  href: string;
}

const { emoji, title, description, href } = Astro.props;
---

<a class="policy-card" href={href}>
  <div class="emoji">{emoji}</div>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
.policy-card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 1.5rem;
  background: #ffffff;
  box-sizing: border-box;
  height: 100%;
  color: inherit;
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.policy-card:hover,
.policy-card:focus-visible {
  text-decoration: none;
}

.policy-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
  border-color: var(--color-party-primary);
}

.emoji {
  font-size: 2rem;
  margin-bottom: 0.75rem;
}

.policy-card h3 {
  margin-top: 0;
  margin-bottom: 0.5rem;
  color: var(--color-party-primary);
  font-size: 1.25rem;
}

.policy-card p {
  margin-bottom: 0;
  color: #4b5563;
  font-size: 0.95rem;
  line-height: 1.6;
  flex-grow: 1;
}
</style>
