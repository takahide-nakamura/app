---
import { socials } from "../data/socials";
import { getBaseUrl } from "../lib/siteUrl";

interface Props {
  compact?: boolean;
  descriptions?: Partial<Record<"youtube" | "x" | "threads" | "instagram" | "note" | "line", string>>;
}

const { compact = false, descriptions } = Astro.props;
const base = getBaseUrl();
---

<nav
  class:list={["social-links", { "social-links--compact": compact }]}
  aria-label="SNS"
>
  {socials.youtube.url && (
    <a
      href={socials.youtube.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.youtube.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/youtube.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : descriptions ? (
          <span class="social-main">
            <img
              class="social-icon"
              src={`${base}images/social/youtube.svg`}
              alt=""
              aria-hidden="true"
            />
            <span class="social-text">
              <span class="social-name">{socials.youtube.name}</span>
              {descriptions.youtube && (
                <span class="social-desc">{descriptions.youtube}</span>
              )}
            </span>
          </span>
        ) : (
          socials.youtube.name
        )
      }
    </a>
  )}

  {socials.x.url && (
    <a
      href={socials.x.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.x.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/x.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : descriptions ? (
          <span class="social-main">
            <img
              class="social-icon"
              src={`${base}images/social/x.svg`}
              alt=""
              aria-hidden="true"
            />
            <span class="social-text">
              <span class="social-name">{socials.x.name}</span>
              {descriptions.x && (
                <span class="social-desc">{descriptions.x}</span>
              )}
            </span>
          </span>
        ) : (
          socials.x.name
        )
      }
    </a>
  )}

    {socials.threads.url && (
    <a
      href={socials.threads.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.threads.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/threads.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : descriptions ? (
          <span class="social-main">
            <img
              class="social-icon"
              src={`${base}images/social/threads.svg`}
              alt=""
              aria-hidden="true"
            />
            <span class="social-text">
              <span class="social-name">{socials.threads.name}</span>
              {descriptions.threads && (
                <span class="social-desc">{descriptions.threads}</span>
              )}
            </span>
          </span>
        ) : (
          socials.threads.name
        )
      }
    </a>
  )}

  {socials.instagram.url && (
    <a
      href={socials.instagram.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.instagram.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/instagram.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : descriptions ? (
          <span class="social-main">
            <img
              class="social-icon"
              src={`${base}images/social/instagram.svg`}
              alt=""
              aria-hidden="true"
            />
            <span class="social-text">
              <span class="social-name">{socials.instagram.name}</span>
              {descriptions.instagram && (
                <span class="social-desc">{descriptions.instagram}</span>
              )}
            </span>
          </span>
        ) : (
          socials.instagram.name
        )
      }
    </a>
  )}

  {socials.note.url && (
    <a
      href={socials.note.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.note.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/note.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : descriptions ? (
          <span class="social-main">
            <img
              class="social-icon"
              src={`${base}images/social/note.svg`}
              alt=""
              aria-hidden="true"
            />
            <span class="social-text">
              <span class="social-name">{socials.note.name}</span>
              {descriptions.note && (
                <span class="social-desc">{descriptions.note}</span>
              )}
            </span>
          </span>
        ) : (
          socials.note.name
        )
      }
    </a>
  )}

  {socials.line.url && (
    <a
      href={socials.line.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.line.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/line.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : descriptions ? (
          <span class="social-main">
            <img
              class="social-icon"
              src={`${base}images/social/line.svg`}
              alt=""
              aria-hidden="true"
            />
            <span class="social-text">
              <span class="social-name">{socials.line.name}</span>
              {descriptions.line && (
                <span class="social-desc">{descriptions.line}</span>
              )}
            </span>
          </span>
        ) : (
          socials.line.name
        )
      }
    </a>
  )}
</nav>
<style>
  .social-main {
    display: contents;
  }

  .social-icon {
    width: 22px;
    height: 22px;
    justify-self: center;
    object-fit: contain;
  }

  .social-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .social-desc {
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>