---
import { socials } from "../data/socials";
import { getBaseUrl } from "../lib/siteUrl";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const base = getBaseUrl();
---

<nav
  class:list={["social-links", { "social-links--compact": compact }]}
  aria-label="SNS"
>
  {socials.youtube.url && (
    <a
      href={socials.youtube.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.youtube.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/youtube.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : (
          socials.youtube.name
        )
      }
    </a>
  )}

  {socials.x.url && (
    <a
      href={socials.x.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.x.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/x.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : (
          socials.x.name
        )
      }
    </a>
  )}

  {socials.instagram.url && (
    <a
      href={socials.instagram.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.instagram.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/instagram.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : (
          socials.instagram.name
        )
      }
    </a>
  )}

  {socials.note.url && (
    <a
      href={socials.note.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.note.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/note.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : (
          socials.note.name
        )
      }
    </a>
  )}

  {socials.line.url && (
    <a
      href={socials.line.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={socials.line.name}
    >
      {
        compact ? (
          <img
            src={`${base}images/social/line.svg`}
            alt=""
            aria-hidden="true"
          />
        ) : (
          socials.line.name
        )
      }
    </a>
  )}
</nav>