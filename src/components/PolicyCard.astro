---
interface Props {
  title: string;
  summary: string;
  href?: string;
  available?: boolean;
  tags: string[];
}

const {
  title,
  summary,
  tags = [],
  href = "#",
  available = false
} = Astro.props;
---

<article class="policy-card">
  <h2>{title}</h2>

  <p class="summary">
    {summary}
  </p>

  {
    tags && tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )
  }

  <p class="more">
    {
      available ? (
        <a href={href} class="btn btn-primary">
          詳しく見る
        </a>
      ) : (
        <span class="btn btn-disabled">
          準備中
        </span>
      )
    }
  </p>
</article>

<style>
.policy-card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: var(--radius, 12px);
  padding: 1.5rem;
  background: #fff;
  box-sizing: border-box;
  height: 100%;
}

.policy-card h2 {
  margin-top: 0;
  margin-bottom: 0.75rem;
  color: var(--color-primary, #003f88);
  font-size: 1.25rem;
  line-height: 1.4;
}

.summary {
  line-height: 1.7;
  color: #444;
  font-size: 0.95rem;
  margin-bottom: 1rem;
  flex-grow: 1;
}

/* 複数タグをきれいに並べるレイアウト */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 1.25rem;
}

.tag {
  font-size: 0.78rem;
  padding: 0.25rem 0.6rem;
  background: #f0f4f8;
  color: var(--color-primary, #003f88);
  border: 1px solid #d0e1f9;
  border-radius: 999px;
  font-weight: 500;
  transition: all 0.2s ease;
  user-select: none;
}

.tag:hover {
  background: #003f88;
  color: #ffffff;
  border-color: #003f88;
}

.more {
  margin-top: auto;
  margin-bottom: 0;
  text-align: right;
}

.btn-disabled {
  display: inline-block;
  padding: 0.5rem 1.25rem;
  background: #e5e7eb;
  color: #666;
  border-radius: 6px;
  font-size: 0.9rem;
  cursor: not-allowed;
}
</style>