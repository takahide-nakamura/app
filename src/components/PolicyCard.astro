---
interface Props {
  title: string;
  summary: string;
  href?: string;
  available?: boolean;
}

const {
  title,
  summary,
  href = "#",
  available = false
} = Astro.props;

---

<article class="policy-card">
  <h2>{title}</h2>

  <p class="summary">
    {summary}
  </p>

  <div class="labels">
    <span class="label official">🔵 公的資料</span>
    <span class="label private">🟣 民間調査</span>
    <span class="label field">🟢 現場経験</span>
    <span class="label citizen">🟡 市民の声</span>
  </div>

  <section class="proposal">
    <h3>💡 私の提案</h3>

    <p>
      （ここに提案内容を掲載します）
    </p>
  </section>
  
  <p class="more">
  {
    available ? (
      <a href={href} class="btn btn-primary">
        詳しく見る
      </a>
    ) : (
      <span class="btn btn-disabled">
        準備中
      </span>
    )
  }
  </p>

</article>

<style>
.policy-card{
  border:1px solid #ddd;
  border-radius:16px;
  padding:2rem;
  margin-bottom:2rem;
  background:#fff;
}

.summary{
  line-height:1.8;
}

.labels{
  display:flex;
  flex-wrap:wrap;
  gap:.5rem;
  margin:1.5rem 0;
}

.label{
  padding:.4rem .8rem;
  border-radius:999px;
  font-size:.9rem;
  background:#f5f5f5;
}

.proposal{
  margin-top:2rem;
  padding-top:1rem;
  border-top:1px solid #eee;
}

.more{
  margin-top:2rem;
  text-align:right;
}

.btn-disabled{
  background:#ddd;
  color:#666;
  cursor:not-allowed;
}

</style>