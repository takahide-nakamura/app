---
import { getBaseUrl } from "../lib/siteUrl";

const base = getBaseUrl();

interface Props {
  title:string;
  summary:string;
  tags:string[];
  href:string;
  available:boolean;
}

const {
  title,
  summary,
  tags,
  href,
  available
} = Astro.props;

// tagsが配列であることを保証
const safeTags = Array.isArray(tags) ? tags : [];
---

<article class="policy-card">
  <h2>{title}</h2>

  <p class="summary">
    {summary}
  </p>

  {
    safeTags.length > 0 && (
      <div class="tags">
        {safeTags.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )
  }

  <p class="more">
    {
      available ? (
        <a href={`${base}${href.replace(/^\//,"")}`} class="btn btn-primary">
          詳しく見る
        </a>
      ) : (
        <span class="btn btn-disabled">
          準備中
        </span>
      )
    }
  </p>
</article>

<style>
.policy-card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 1.5rem;
  background: var(--color-background);
  box-sizing: border-box;
  height: 100%;
}

.policy-card h2 {
  margin-top: 0;
  margin-bottom: 0.75rem;
  color: var(--color-party-primary);
  font-size: var(--text-xl);
  line-height: 1.4;
}

.summary {
  line-height: 1.7;
  color: var(--color-text);
  font-size: var(--text-base);
  margin-bottom: 1rem;
  flex-grow: 1;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 1.25rem;
}

.tag {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: var(--color-party-primary-subtle);
  color: var(--color-party-primary);
  border: 1px solid var(--color-party-primary-border);
  border-radius: var(--radius-full);
  font-weight: 500;
}

.more {
  margin-top: auto;
  margin-bottom: 0;
  text-align: right;
}

.btn-disabled {
  display: inline-block;
  padding: 0.5rem 1.25rem;
  background: var(--color-border);
  color: var(--color-text-subtle);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  cursor: not-allowed;
}
</style>