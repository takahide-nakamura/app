---
// Astro組み込みのベースURL（astro.config.mjs の base: '/app' を参照）
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
import SocialLinks from "./SocialLinks.astro";
---
<footer class="site-footer">
  <div class="footer-inner container">
   
   <span class="author-name">中村たかひで</span>
   <p class="site-name">もっと住みやすい高槻へ</p>

    <p class="message">
      事実に向き合い、市民の皆さんとの対話を重ね、<br class="pc-br" />
      もっと住みやすい高槻をつくる。
    </p>

    <nav class="footer-nav" aria-label="主要フッターリンク">
      <a href={`${base}policy/`}>政策</a>
      <a href={`${base}activity/`}>活動</a>
      <a href={`${base}profile/`}>プロフィール</a>
      <a href={`${base}opinions/`}>市民の声</a>
      <a href={`${base}contact/`}>お問い合わせ</a>
    </nav>
    <SocialLinks />

    <nav class="legal-nav" aria-label="サイト情報">
      <a href={`${base}privacy-policy/`}>プライバシーポリシー</a>
      <a href={`${base}terms/`}>利用規約</a>
    </nav>

    <p class="copyright">Copyright © 2026 Nakamaura Takahide. All rights reserved.</p>
  </div>
</footer>

<style>
.site-footer {
  margin-top: 1rem;
  border-top: 1px solid #e5e7eb;
  padding: 2.5rem 0 2rem;
  background: #fff;
}

.footer-inner {
  text-align: center;
}

.site-name {
  font-size: 1.3rem;
  font-weight: 700;
  color: #003f88;
  margin-bottom: 0.5rem;
}

.message {
  margin: 1rem auto 2rem;
  max-width: 700px;
  line-height: 1.8;
  color: #444;
}

.footer-nav {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.footer-nav a {
  text-decoration: none;
  color: #003f88;
  font-weight: 600;
}

.footer-nav a:hover {
  text-decoration: underline;
}

.legal-nav {
  display: flex;
  justify-content: center;
  gap: 1.25rem;
  flex-wrap: wrap;
  margin: 0.5rem 0 1.5rem;
}

.legal-nav a {
  min-height: 2.75rem;
  display: inline-flex;
  align-items: center;
  color: #555;
  font-size: 0.875rem;
  font-weight: 400;
  text-decoration: none;
}

.legal-nav a:hover {
  color: #003f88;
  text-decoration: underline;
}

.copyright {
  font-size: 0.9rem;
  color: #666;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}
</style>