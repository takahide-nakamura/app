---
// Astro組み込みのベースURL（astro.config.mjs の base: '/app' を参照）
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
import SocialLinks from "./SocialLinks.astro";
import { politicalAffiliation } from "../data/politicalAffiliation";
---
<footer class="site-footer">
  <div class="footer-inner container">
    <span class="author-name">中村たかひで</span>
    <p class="site-name">もっと住みやすい高槻へ</p>
    {politicalAffiliation.enabled && (
      <p class="party-affiliation">{politicalAffiliation.displayName}</p>
    )}

    {politicalAffiliation.enabled && (
      <a class="party-logo-link" href={politicalAffiliation.officialUrl || `${base}`} target={politicalAffiliation.officialUrl ? "_blank" : undefined} rel={politicalAffiliation.officialUrl ? "noopener noreferrer" : undefined} aria-label={politicalAffiliation.logoAlt}>
        <img src={politicalAffiliation.logoSrc} alt={politicalAffiliation.logoAlt} class="party-logo" />
      </a>
    )}

    <p class="message">
      高槻市の現場と市民の声を丁寧に見つめ、<br class="pc-br" />
      住みやすいまちを目指して政策と活動を発信しています。
    </p>

    <nav class="footer-nav" aria-label="主要フッターリンク">
      <a href={`${base}policy/`}>政策</a>
      <a href={`${base}activity/`}>活動</a>
      <a href={`${base}profile/`}>プロフィール</a>
      <a href={`${base}opinions/`}>市民の声</a>
      <a href={`${base}contact/`}>お問い合わせ</a>
    </nav>
    <SocialLinks />

    <nav class="legal-nav" aria-label="サイト情報">
      <a href={`${base}privacy-policy/`}>プライバシーポリシー</a>
      <a href={`${base}terms/`}>利用規約</a>
    </nav>

    <p class="copyright">Copyright © 2026 Nakamaura Takahide. All rights reserved.</p>
  </div>
</footer>

<style>
.site-footer {
  margin-top: 1rem;
  border-top: 1px solid #e5e7eb;
  padding: 2.5rem 0 2rem;
  background: #fff;
}

.footer-inner {
  text-align: center;
}

.author-name {
  display: block;
  color: var(--color-personal-brand);
  font-weight: 700;
  margin-bottom: 0.25rem;
}

.site-name {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 0.25rem;
}

.party-affiliation {
  margin: 0 0 1rem;
  color: #4b5563;
  font-weight: 600;
}

.party-logo-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
}

.party-logo {
  display: block;
  max-height: 54px;
  width: auto;
  max-width: 160px;
  object-fit: contain;
}

.message {
  margin: 1rem auto 2rem;
  max-width: 700px;
  line-height: 1.8;
  color: #444;
}

.footer-nav {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.footer-nav a {
  text-decoration: none;
  color: var(--color-primary);
  font-weight: 600;
}

.footer-nav a:hover {
  text-decoration: underline;
}

.legal-nav {
  display: flex;
  justify-content: center;
  gap: 1.25rem;
  flex-wrap: wrap;
  margin: 0.5rem 0 1.5rem;
}

.legal-nav a {
  min-height: 2.75rem;
  display: inline-flex;
  align-items: center;
  color: #555;
  font-size: 0.875rem;
  font-weight: 400;
  text-decoration: none;
}

.legal-nav a:hover {
  color: var(--color-primary);
  text-decoration: underline;
}

.copyright {
  font-size: 0.9rem;
  color: #666;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}

@media (max-width: 768px) {
  .site-footer {
    padding: 1.8rem 0 1.25rem;
  }

  .party-affiliation {
    margin-bottom: 0.75rem;
  }

  .message {
    margin-top: 0.75rem;
    margin-bottom: 1.4rem;
  }

  .footer-nav {
    gap: 0.8rem 1rem;
    margin-bottom: 1.4rem;
  }

  .legal-nav {
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
}
</style>