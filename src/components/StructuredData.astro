---
import { politicalAffiliation } from "../data/politicalAffiliation";

interface Props {
  description?: string;
}

const {
  description = "医療・介護・子育て・まちづくりなど、高槻市をもっと住みやすくするための政策を提案しています。"
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      "url": Astro.site,
      "name": "もっと住みやすい高槻へ",
      "description": description,
      "inLanguage": "ja"
    },
    {
      "@type": "Person",
      "@id": `${Astro.site}#person`,
      "name": "中村たかひで",
      "jobTitle": politicalAffiliation.enabled ? politicalAffiliation.displayName : "市民活動家",
      "url": Astro.site,
      "affiliation": politicalAffiliation.enabled ? {
        "@type": "Organization",
        "name": politicalAffiliation.partyName,
        "url": politicalAffiliation.officialUrl || undefined,
      } : undefined,
       "sameAs": []
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />