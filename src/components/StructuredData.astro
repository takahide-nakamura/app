---
import { politicalAffiliation } from "../data/politicalAffiliation";
import { socials } from "../data/socials";
import { getCanonicalUrl } from "../lib/siteUrl";

const site = Astro.site ?? Astro.url;
const websiteURL = getCanonicalUrl("/", site);
const profileURL = getCanonicalUrl("profile/", site);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${websiteURL}#website`,
      "url": websiteURL,
      "name": "もっと住みやすい高槻へ",
      "description": "高槻市の政策・活動・根拠を公開し、市民との対話につなげる情報プラットフォームです。",
      "inLanguage": "ja"
    },
    {
      "@type": "Person",
      "@id": `${profileURL}#person`,
      "name": "中村たかひで",
      "jobTitle": politicalAffiliation.enabled ? politicalAffiliation.role : undefined,
      "url": profileURL,
      "affiliation": politicalAffiliation.enabled ? {
        "@type": "Organization",
        "name": politicalAffiliation.partyName,
        "url": politicalAffiliation.officialUrl || undefined,
      } : undefined,
      "sameAs": [
        socials.youtube.url,
        socials.x.url,
        socials.instagram.url,
        socials.note.url,
      ]
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />