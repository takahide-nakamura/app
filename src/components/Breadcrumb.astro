---
interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav
  class="breadcrumb"
  aria-label="パンくずリスト"
>

  <ol>

    <li>
      <a href="/">
        ホーム
      </a>
    </li>

    <li aria-hidden="true">
      ›
    </li>

    <li>
      <a href="/policy/">
        政策
      </a>
    </li>

    <li aria-hidden="true">
      ›
    </li>

    <li
      aria-current="page"
    >
      {current}
    </li>

  </ol>

</nav>

<style>

.breadcrumb{

  margin:.25rem 0 1.75rem;

  font-size:.9rem;

}

.breadcrumb ol{

  display:flex;

  flex-wrap:wrap;

  align-items:center;

  gap:.5rem;

  list-style:none;

  padding:0;

  margin:0;

}

.breadcrumb li{

  color:#666;

}

.breadcrumb a{

  color:var(--color-primary);

  text-decoration:none;

}

.breadcrumb a:hover{

  text-decoration:underline;

}

.breadcrumb li[aria-current="page"]{

  color:#333;

  font-weight:600;

}

@media (max-width:768px){

  .breadcrumb{

    font-size:.85rem;

    margin:.25rem 0 1.25rem;

  }

}

</style>