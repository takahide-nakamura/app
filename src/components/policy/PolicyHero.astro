---
interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;

// ビルド（公開）時の日付を固定値として取得（閲覧時に変動しない）
const BUILD_DATE = new Date().toISOString().split("T")[0];

// updated が直接指定されていればそれを使い、無ければビルド時の固定日付を使用
const displayDate = updated || BUILD_DATE;
---

<section class="policy-hero">
  <h1>{title}</h1>

  <p class="description">
    {description}
  </p>

  {
    displayDate && (
      <p class="updated">
        更新日：<time datetime={displayDate}>{displayDate}</time>
      </p>
    )
  }
</section>

<style>
  .policy-hero {
    text-align: center;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem 0; /* 48pxからコンパクトな16px(1rem)に縮小 */
  }

  .policy-hero h1 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    line-height: 1.3;
    font-size: 1.8rem;
    color: var(--color-primary, #003f88);
  }

  .description {
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.8;
    color: #444;
    font-size: 1rem;
  }

  .updated {
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.75rem;
    margin-bottom: 0;
    text-align: right;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 768px) {
    .policy-hero {
      margin-top: 1.5rem;
      margin-bottom: 2rem;
      padding: 1.5rem 0;
    }

    .policy-hero h1 {
      font-size: 2.2rem;
    }
  }
</style>