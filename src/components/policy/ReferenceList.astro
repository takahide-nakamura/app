---
import PolicySection from "../PolicySection.astro";
import SourceCard from "../SourceCard.astro";

interface Source {
  title: string;
  publisher: string;
  year: string;
  url: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props as Props;
---

<PolicySection title="参考資料・出典">
  {
    sources.map((source) => (
      <SourceCard
        title={source.title}
        publisher={source.publisher}
        year={source.year}
        url={source.url}
      />
    ))
  }
</PolicySection>