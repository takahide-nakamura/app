---
import PolicySection from "../PolicySection.astro";
import SourceCard from "../SourceCard.astro";

interface Source {
  title: string;
  publisher: string;
  year?: string;
  checked?: string;
  evidenceLevel?: string;
  url?: string;
}

interface Props {
  sources?: Source[];
}

const { sources = [] } = Astro.props as Props;
---

{
  sources.length > 0 && (
    <PolicySection
      title="参考資料"
      icon="📚"
    >

      {
        sources.map((source) => (
          <SourceCard
            title={source.title}
            publisher={source.publisher}
            year={source.year}
            checked={source.checked}
            evidenceLevel={source.evidenceLevel}
            url={source.url}
          />
        ))
      }

    </PolicySection>
  )
}