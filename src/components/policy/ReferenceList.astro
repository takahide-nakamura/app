---
import PolicySection from "../PolicySection.astro";
import SourceCard from "../SourceCard.astro";

interface Source {
  title: string;
  publisher: string;
  year?: string;
  url?: string;
  type?: "official" | "statistics" | "law" | "research" | "meeting" | "other";
  status?: "current" | "historical" | "archived";
  checked?: string;
}

interface Props {
  sources?: Source[];
}

const { sources = [] } = Astro.props as Props;
---

{
  sources.length > 0 && (
    <PolicySection
      title="参考資料"
      icon="📚"
    >
      {
        sources
          .filter((source) => source.status !== "archived")
          .map((source) => (
            <SourceCard
              title={source.title}
              publisher={source.publisher}
              year={source.year}
              url={source.url}
              type={source.type}
              status={source.status}
              checked={source.checked}
            />
          ))
      }
    </PolicySection>
  )
}