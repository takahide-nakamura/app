---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="proposal-list">
  {items.map((item) => (
    <li>{item}</li>
  ))}
</ul>

<style>
  .proposal-list {
    margin-top: var(--space-sm, 0.5rem);
    margin-bottom: var(--space-md, 1rem);
    padding-left: 1.25rem;
  }

  .proposal-list li {
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }
</style>