---
interface Activity {
  title: string;
  href: string;
}

interface Props {
  activities?: Activity[];
  maxItems?: number;
}

const {
  activities = [],
  maxItems = 3
} = Astro.props;

const visibleActivities = activities
  .filter(activity => activity.title && activity.href)
  .slice(0, maxItems);
---

{
  visibleActivities.length > 0 && (
    <section class="related-activities">
      <h2>関連する活動</h2>

      <div class="activity-grid">
        {
          visibleActivities.map((activity) => (
            <div class="activity-card">
              <h3>{activity.title}</h3>
              <p class="link">
                <a
                  href={activity.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  活動内容を見る（新しいタブで開きます）
                </a>
              </p>
            </div>
          ))
        }
      </div>
    </section>
  )
}

<style>
.related-activities {
  margin-bottom: var(--space-xl);
}

.activity-grid {
  display: grid;
  gap: 1rem;
}

.activity-card {
  border: 1px solid #ddd;
  border-radius: 12px;
  padding: 1.25rem;
  background: #fff;
}

.activity-card h3 {
  margin: 0 0 1rem;
  color: var(--color-primary);
  font-size: 1.05rem;
}

.link {
  margin-top: 1rem;
  margin-bottom: 0;
}

.link a {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 600;
}

.link a:hover {
  text-decoration: underline;
}
</style>