---
import { getBaseUrl } from "../lib/siteUrl";

const base = getBaseUrl();
---

<section class="hero-section container">
  <div class="hero-content">
    <p class="hero-person-name">中村たかひで</p>
    <h1>
      <span class="title-main">もっと</span>
      <span class="title-main">住みやすい</span>
      <span class="title-accent">高槻へ</span>
    </h1>
    <p class="hero-description">
      高槻市の暮らしに関わる課題を、データと現場経験から整理し、<br class="pc-br" />
      具体的な政策と活動の記録として公開しています。
    </p>
    <div class="hero-actions">
      <a href={`${base}policy/`} class="btn btn-primary">政策を見る</a>
      <a
        href={`${base}contact/`}
        class="btn btn-secondary"
        onclick="gtag('event', 'click_contact', { link_location: 'hero' })"
      >
       お問い合わせ
      </a>
    </div>
  </div>
  <figure class="hero-banner">
    <img
     src={`${base}ogp.webp`}
     alt="医療・介護・福祉の現場経験から考える政策「もっと住みやすい高槻へ」。理学療法士・中村たかひで"
     width="1200"
     height="630"
     fetchpriority="high"
    />
  </figure>

</section>

<style>
.hero-section {
  text-align: center !important;
  padding-top: clamp(2.5rem, 6vw, 5rem);
  padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
}

.hero-content {
  max-width: 980px;
  margin: 0 auto;
}

.hero-content h1 {
  display: flex;
  justify-content: center;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.15em;
  margin: 0;
  font-size: clamp(3.2rem, 7vw, 6rem);
  line-height: 0.96;
  letter-spacing: -0.03em;
}

.hero-person-name {
  margin: 0 0 0.75rem;
  color: var(--color-text-muted);
  font-size: clamp(1.05rem, 2.2vw, 1.5rem);
  font-weight: 700;
  letter-spacing: 0.08em;
}

.title-main,
.title-accent {
  display: inline-block;
}

.title-main {
  /* 中村たかひで パーソナルブランドカラー */
  color: var(--color-personal-brand);
  /* 縁取りはやめ、同色の柔らかい影だけにする */
  text-shadow: 0 4px 18px color-mix(in srgb, var(--color-personal-brand) 35%, transparent);
}

.title-accent {
  /* 政党メインカラー */
  color: var(--color-party-primary);
  text-shadow: none;
}

.hero-description {
  max-width: 760px;
  margin: 1.75rem auto 2rem;
  font-size: var(--text-lg);
  line-height: 1.8;
  word-break: normal;
  overflow-wrap: break-word;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}

.hero-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

@media (max-width: 768px) {
  .hero-content h1 {
    gap: 0.08em;
    font-size: clamp(2.4rem, 14vw, 4.6rem);
    line-height: 1.02;
  }

  .title-main,
  .title-accent {
    display: block;
  }

  .hero-description {
    font-size: var(--text-base);
  }
}
.hero-banner {
margin: 2.5rem auto 0;
max-width: 880px;
}

.hero-banner img {
display: block;
width: 100%;
height: auto;
border-radius: var(--radius-lg);
box-shadow: var(--shadow-lg);
}
</style>