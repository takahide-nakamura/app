---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  breadcrumb?: string;
}

const {
  title,
  description,
  breadcrumb = ""
} = Astro.props;
---

<Layout
  title={title}
  description={description}
>

   <Header />

    <main class="policy-detail container" id="main-content" tabindex="-1">

     {
        breadcrumb && (
         <Breadcrumb current={breadcrumb} />
        )
     }

      <article>
       <slot />
      </article>

    </main>

  <Footer />

</Layout>

<style>
.policy-detail{
  max-width: var(--content-width);
  margin: 0 auto;
  padding: var(--space-xl);
}

.breadcrumb{
  font-size: .9rem;
  margin-bottom: 1rem;
  color: #666;
}

.breadcrumb a{
  color: inherit;
  text-decoration: none;
}

.breadcrumb span{
  margin: 0 0.35rem;
}


@media (max-width:768px){

.policy-detail{
  padding: var(--space-md);
}

}
</style>