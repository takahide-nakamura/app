---
import Layout from "../layouts/Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { getBaseUrl } from "../lib/siteUrl";
import { politicalAffiliation } from "../data/politicalAffiliation";

const base = getBaseUrl();
const title = "中村たかひで｜公式リンク集";
const description = "中村たかひでの公式サイト、各SNS（YouTube・X・Instagram・Threads等）、政策や活動情報への公式リンク一覧です。";
---

<Layout title={title} description={description}>
  <main class="links-page" id="main-content" tabindex="-1">
    <header class="links-header">
      <div class="profile-mark">
        <img
          src={`${base}images/profile/nakamura-takahide.png`}
          alt="中村たかひでのプロフィール写真"
          width="96"
          height="96"
        />
      </div>
      <h1>中村たかひで</h1>
      <p>もっと住みやすい高槻へ</p>
      {politicalAffiliation.enabled && (
        <p class="links-affiliation">{politicalAffiliation.displayName}</p>
      )}
    </header>

<!-- 🟢 最上位：プロフィール & 公式サイト -->
    <section class="links-section" aria-labelledby="profile-heading">
      <h2 id="profile-heading">プロフィール・公式サイト</h2>
      <div class="link-list">
        <!-- 名刺用最上位導線 -->
        <a class="link-card link-card-primary" href={`${base}profile/`}>
          <span class="link-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <span class="link-label">プロフィール（経歴・想い）</span>
          <span class="link-arrow" aria-hidden="true">→</span>
        </a>

        <!-- トップページ導線 -->
        <a class="link-card" href={`${base}`}>
          <span class="link-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </span>
          <span class="link-label">公式サイト トップページ</span>
          <span class="link-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- SNS・公式LINE -->
    <section class="links-section" aria-labelledby="sns-heading">
      <h2 id="sns-heading">SNS・公式LINE</h2>
      <div class="social-links-wrapper">
        <SocialLinks
          descriptions={{
            youtube: "制度や補助金のことを、動画で簡潔に説明します",
            x: "毎日の活動の様子をお知らせします",
            threads: "高槻のイベントや歴史、お店のことを紹介します",
            instagram: "高槻のイベントや歴史、お店のことを紹介します",
            note: "暮らしに役立つ情報や政策を紹介します",
          }}
        />
      </div>
    </section>

    <!-- サイト内コンテンツ -->
    <section class="links-section" aria-labelledby="site-heading">
      <h2 id="site-heading">サイトを見る</h2>
      <div class="site-grid">
        <a class="link-card" href={`${base}policy/`}>
          <span class="link-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </span>
          <span class="link-label">政策</span>
          <span class="link-arrow" aria-hidden="true">→</span>
        </a>

        <a class="link-card site-grid-wide" href={`${base}opinions/`}>
          <span class="link-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <span class="link-label">市民の声・対応状況</span>
          <span class="link-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .links-page {
    width: min(100% - 2rem, 520px);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
  }

  .links-header {
    text-align: center;
    margin-bottom: 2.5rem;
    padding: 2rem 1rem 1.75rem;
    border-radius: var(--radius-lg);
    background: radial-gradient(
      ellipse 90% 110% at 50% 0%,
      var(--color-accent-subtle) 0%,
      transparent 72%
    );
  }

  .profile-mark {
    width: 96px;
    height: 96px;
    margin: 0 auto 1rem;
    border: 3px solid var(--color-personal-brand);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .profile-mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;  /* ← この1行を足す */
  }


  .links-header h1 {
    margin: 0;
    color: var(--color-personal-brand); /* パーソナルカラーを適用 */
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .links-header p {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .links-affiliation {
    margin: 0.4rem 0 0;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .links-section {
    margin-top: 2.25rem;
  }

  .links-section:first-of-type {
    margin-top: 0;
  }

  .links-section h2 {
    position: relative;
    margin: 0 0 0.75rem;
    padding-bottom: 0.45rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .links-section h2::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 2rem;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--color-personal-brand);
  }

  .link-list,
  .site-grid {
    display: grid;
    gap: 0.75rem;
  }

  .site-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-grid-wide {
    grid-column: 1 / -1;
  }

  /* 共通リンクカードデザイン */
  .link-card {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr 1.5rem;
    align-items: center;
    min-height: 60px;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }

  .link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-personal-brand);
    box-shadow: var(--shadow-md);
  }

  .link-card:active {
    transform: translateY(0);
  }

/* 最上位プライマリーカード（プロフィール） */
  .link-card-primary {
    border-color: var(--color-personal-brand);
    border-width: 2px;
    background: linear-gradient(
      135deg,
      var(--color-accent-subtle) 0%,
      var(--color-background) 78%
    );
  }
  .link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-personal-brand);
  }

  .link-label {
    min-width: 0;
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.4;
  }

  .link-arrow {
    justify-self: end;
    color: var(--color-text-subtle);
    font-size: var(--text-lg);
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }

  .link-card:hover .link-arrow {
    color: var(--color-personal-brand);
    transform: translateX(3px);
  }

  /* SocialLinks コンポーネント内の <a> 要素に共通カードスタイルを適用 */
  .social-links-wrapper :global(.social-links) {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .social-links-wrapper :global(.social-links a) {
    display: grid;
    /* SNSリンクの中身は「サービス名テキスト＋::afterの矢印」の2要素だけなので、
       アイコン列のある共通カードと列構成を分ける（テキストが2rem列に落ちて潰れるのを防ぐ） */
    grid-template-columns: 2rem minmax(0, 1fr) 1.5rem;
    align-items: center;
    min-height: 60px;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }

  .social-links-wrapper :global(.social-links a:hover) {
    transform: translateY(-2px);
    border-color: var(--color-personal-brand);
    box-shadow: var(--shadow-md);
  }

  .social-links-wrapper :global(.social-links a::after) {
    content: "→";
    justify-self: end;
    color: var(--color-text-subtle);
    font-size: var(--text-lg);
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }

  .social-links-wrapper :global(.social-links a:hover::after) {
    color: var(--color-personal-brand);
    transform: translateX(3px);
  }

  @media (max-width: 480px) {
    .links-page {
      width: min(100% - 1.5rem, 520px);
    }

    .profile-mark {
      width: 80px;
      height: 80px;
    }

    .link-card,
    .social-links-wrapper :global(.social-links a) {
      min-height: 56px;
      padding: 0.75rem 0.85rem;
    }

    .link-label {
      font-size: var(--text-sm);
    }
  }
</style>