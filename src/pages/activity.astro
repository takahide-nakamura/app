---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allActivities = await getCollection("activities", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// ベースURLの整形（末尾のスラッシュを担保）
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;

// ステータスが "published" のものだけを表示対象とします
const publishedActivities = allActivities
  .filter((activity) => activity.data.status === "published")
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map((activity) => ({
    id: activity.id,
    title: activity.data.title,
    summary: activity.data.summary,
    date: activity.data.date,
    thumbnail: activity.data.thumbnail,
    href: `${base}activity/${activity.id}/`,
  }));

---

<Layout
  title="活動｜もっと住みやすい高槻へ"
  description="高槻市での現場訪問、市民との対話、現場調査などの活動記録を掲載しています。"
>
  <Header />

  <main class="activity-page container" id="main-content" tabindex="-1">
    <section class="hero">
      <h1>活動</h1>
      <p>
        事実と対話を大切にし、<br class="pc-br" />
        現場での取り組みや対話の記録を発信しています。
      </p>
    </section>

    <div class="cards-grid">
      {
        publishedActivities.length > 0 ? (
          publishedActivities.map((item) => (
            <article class="activity-card">
              {item.thumbnail ? (
                <img class="card-thumbnail" src={item.thumbnail} alt="" />
              ) : (
                <div class="card-placeholder" aria-hidden="true">活動記録</div>
              )}

              <div class="card-content">
                <h2 class="card-title">{item.title}</h2>
                <time class="card-date" datetime={item.date}>{item.date}</time>
                <p class="card-summary">{item.summary}</p>
              </div>

              <div class="card-footer">
                {item.href ? (
                  <a href={item.href} class="btn-more">
                    詳しく見る <span class="arrow">→</span>
                  </a>
                ) : (
                  <span class="btn-disabled">準備中</span>
                )}
              </div>
            </article>
          ))
        ) : (
          <p class="no-data">現在表示できる活動記事はありません。</p>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>

<style>
.activity-page {
  padding-top: 2rem;
  padding-bottom: 3rem;
}

.hero {
  text-align: center;
  margin-bottom: 2rem;
}

.hero p {
  line-height: 1.8;
  color: #444;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

/* カード本体のデザイン */
.activity-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #ffffff;
  border: 1px solid var(--color-border, #e2e8f0);
  border-radius: 12px;
  padding: 1.75rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.card-thumbnail,
.card-placeholder {
  width: calc(100% + 3.5rem);
  height: 180px;
  margin: -1.75rem -1.75rem 1.5rem;
  object-fit: cover;
  border-radius: 12px 12px 0 0;
}

.card-placeholder {
  display: grid;
  place-items: center;
  color: #64748b;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.activity-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);
  border-color: var(--color-primary, #003f88);
}

.card-title {
  margin-top: 0;
  margin-bottom: 0.85rem;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-primary, #003f88);
  line-height: 1.4;
}

.card-summary {
  color: #4a5568;
  line-height: 1.65;
  font-size: 0.95rem;
  margin-bottom: 1.5rem;
}

.card-date {
  display: block;
  margin-bottom: 0.75rem;
  color: #64748b;
  font-size: 0.9rem;
}

.card-footer {
  margin-top: auto;
  padding-top: 1rem;
  border-top: 1px solid #f1f5f9;
  text-align: right;
}

.btn-more {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  color: var(--color-primary, #003f88);
  font-weight: 600;
  text-decoration: none;
  font-size: 0.95rem;
  transition: color 0.15s ease;
}

.btn-more .arrow {
  transition: transform 0.15s ease;
}

.btn-more:hover {
  color: var(--color-accent, #d97706);
}

.btn-more:hover .arrow {
  transform: translateX(4px);
}

.btn-disabled {
  display: inline-block;
  font-size: 0.875rem;
  color: #94a3b8;
  background-color: #f8fafc;
  padding: 0.25rem 0.75rem;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
}

.no-data {
  text-align: center;
  color: #64748b;
  grid-column: 1 / -1;
  padding: 4rem 0;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}
</style>