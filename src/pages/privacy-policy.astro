---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'privacy-policy');
if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title}｜もっと住みやすい高槻へ`}
  description="「もっと住みやすい高槻へ」のプライバシーポリシーです。個人情報の取り扱い、利用目的、安全管理措置等について記載しています。"
>
  <Header />

  <main class="privacy-policy-page page-content" id="main-content" tabindex="-1">
    <div class="content-inner">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
/* Markdownコンテンツのスタイル調整 */
.privacy-policy-page .content-inner {
  max-width: 800px;
  margin: 0 auto;
  padding: clamp(2rem, 5vw, 4rem) 1.5rem;
  line-height: 1.8;
  color: #333;
}

.privacy-policy-page h1 {
  font-size: clamp(1.8rem, 5vw, 2.5rem);
  color: #003f88;
  margin-bottom: 2rem;
  text-align: center;
  border-bottom: 3px solid #003f88;
  padding-bottom: 1rem;
}

.privacy-policy-page h2 {
  font-size: clamp(1.3rem, 4vw, 1.8rem);
  color: #003f88;
  margin: 3rem 0 1.5rem;
  border-left: 6px solid #003f88;
  padding-left: 1rem;
  background: #f8fbff;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
}

.privacy-policy-page h3 {
  font-size: 1.2rem;
  color: #003f88;
  margin: 2rem 0 1rem;
}

.privacy-policy-page p {
  margin-bottom: 1.5rem;
}

.privacy-policy-page ul {
  margin-bottom: 1.5rem;
  padding-left: 1.5rem;
}

.privacy-policy-page li {
  margin-bottom: 0.5rem;
}

.privacy-policy-page strong {
  color: #003f88;
}
</style>
