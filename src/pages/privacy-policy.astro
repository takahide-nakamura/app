---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'privacy-policy');
if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title}｜もっと住みやすい高槻へ`}
  description="「もっと住みやすい高槻へ」のプライバシーポリシーです。個人情報の取り扱い、利用目的、安全管理措置等について記載しています。"
>
  <Header />

  <main class="privacy-policy-page page-content" id="main-content" tabindex="-1">
    <div class="content-inner document-content">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>
