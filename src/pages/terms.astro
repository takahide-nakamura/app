---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'terms');
if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title}｜もっと住みやすい高槻へ`}
  description="「もっと住みやすい高槻へ」の利用規約です。本サイトの利用条件、掲載情報、著作権、禁止事項、免責事項等について記載しています。"
>
  <Header />

  <main class="terms-page page-content" id="main-content" tabindex="-1">
    <div class="content-inner document-content">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>