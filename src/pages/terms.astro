---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'terms');
if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title}｜もっと住みやすい高槻へ`}
  description="「もっと住みやすい高槻へ」の利用規約です。本サイトの利用条件、掲載情報、著作権、禁止事項、免責事項等について記載しています。"
>
  <Header />

  <main class="terms-page page-content" id="main-content" tabindex="-1">
    <div class="content-inner">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
.terms-page .content-inner {
  max-width: 800px;
  margin: 0 auto;
  padding: clamp(2rem, 5vw, 4rem) 1.5rem;
  line-height: 1.8;
  color: #333;
}

.terms-page h1 {
  font-size: clamp(1.8rem, 5vw, 2.5rem);
  color: #003f88;
  margin-bottom: 2rem;
  text-align: center;
  border-bottom: 3px solid #003f88;
  padding-bottom: 1rem;
}

.terms-page h2 {
  font-size: clamp(1.3rem, 4vw, 1.8rem);
  color: #003f88;
  margin: 3rem 0 1.5rem;
  border-left: 6px solid #003f88;
  padding: 0.5rem 0 0.5rem 1rem;
  background: #f8fbff;
}

.terms-page p {
  margin-bottom: 1.5rem;
}

.terms-page ul {
  margin-bottom: 1.5rem;
  padding-left: 1.5rem;
}

.terms-page li {
  margin-bottom: 0.5rem;
}

.terms-page a {
  color: #003f88;
  text-decoration: underline;
  text-underline-offset: 0.15em;
}

.terms-page a:hover {
  color: #002d63;
}
</style>