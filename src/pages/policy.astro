---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PolicyCard from '../components/PolicyCard.astro';
import { policies } from '../data/policies';
import { policyCategories } from "../data/policyCategories";


const groupedPolicies = policyCategories.map((category) => ({
  category,
  policies: policies.filter(
    (policy) =>
      policy.category === category &&
      policy.status === "published"
  )
}));


---

<Layout
   title="政策｜もっと住みやすい高槻へ"
   description="医療・介護・子育て・まちづくりなど、高槻市をもっと住みやすくするための政策を、公開データと現場経験をもとに提案しています。"
  >
  
  <Header />

  <main class="policy-page">

    <section class="hero">
      <h1>政策</h1>

      <p>
        事実と対話を大切にし、
        データや現場経験をもとに政策を考えています。
      </p>
    </section>
 
     {
        groupedPolicies
          .filter((group) => group.policies.length > 0)
          .map((group) => (
            <section class="category-section">

              <h2>{group.category}</h2>

             {
                group.policies.map((policy) => (
                  <PolicyCard
                     title={policy.title}
                     summary={policy.summary}
                     tags={policy.tags}
                     href={policy.href}
                     available={policy.status === "published"}
                  />
                ))
             }

            </section>
         ))
     }

  </main>

  <Footer />

</Layout>

<style>
.policy-page{
  max-width:1100px;
  margin:0 auto;
  padding:4rem 2rem;
}

.hero{
  text-align:center;
  margin-bottom:4rem;
}

.coming-soon{
  text-align:center;
  border:1px solid #ddd;
  border-radius:16px;
  padding:3rem;
}

.category-section{
  margin-bottom: var(--space-xl);
}

.category-section h2{
  color: var(--color-primary);
  border-left: 6px solid var(--color-accent);
  padding-left: 1rem;
  margin-bottom: 2rem;
}

</style>