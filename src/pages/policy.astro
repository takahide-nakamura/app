---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PolicyCard from '../components/PolicyCard.astro';
import { policyCategories } from "../data/policyCategories";
import { getCollection } from "astro:content";

// Content Collections から全政策コンテンツを取得
const allPolicies = await getCollection("policies");

// データ整理
const formattedPolicies = allPolicies.map((entry) => {
  const cleanId = entry.id.replace(/\.md$/, "");
  const data = entry.data;

  // md側にtagsが指定されていればそれを優先、無ければ heroTitle をタグにする
  const tagsList = Array.isArray(data.tags) && data.tags.length > 0
    ? data.tags
    : (data.heroTitle ? [data.heroTitle] : []);

  return {
    id: cleanId,
    title: data.title || "",
    summary: data.description || "",
    tags: tagsList,
    href: `/policy/${cleanId}`,
    status: "published",
    category: data.category || policyCategories[0],
  };
});

// カテゴリーごとのグループ化
const groupedPolicies = policyCategories.map((cat) => {
  return {
    categoryName: cat,
    items: formattedPolicies.filter((p) => p.category === cat)
  };
});
---

<Layout
  title="政策｜もっと住みやすい高槻へ"
  description="医療・介護・子育て・まちづくりなど、高槻市をもっと住みやすくするための政策を、公開データと現場経験をもとに提案しています。"
>
  <Header />

  <main class="policy-page container" id="main-content" tabindex="-1">
    <section class="hero">
      <h1>政策</h1>
      <p>
        事実と対話を大切にし、<br class="pc-br" />
        データや現場経験をもとに政策を考えています。
      </p>
    </section>

    {
      groupedPolicies
        .filter((group) => group.items.length > 0)
        .map((group) => (
          <section class="category-section">
            <h2>{group.categoryName}</h2>

            <div class="cards-grid">
              {
                group.items.map((policy) => (
                  <PolicyCard
                    title={policy.title}
                    summary={policy.summary}
                    tags={policy.tags}
                    href={policy.href}
                    available={policy.status === "published"}
                  />
                ))
              }
            </div>
          </section>
        ))
    }
  </main>

  <Footer />
</Layout>

<style>
.policy-page {
  padding-top: 2rem;
  padding-bottom: 3rem;
}

.hero {
  text-align: center;
  margin-bottom: 2rem;
}

.hero p {
  line-height: 1.8;
  color: #444;
}

.category-section {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

.category-section h2 {
  color: var(--color-primary);
  border-left: 6px solid var(--color-accent);
  padding-left: 1rem;
  margin-bottom: 1.5rem;
  font-size: 1.4rem;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}
</style>