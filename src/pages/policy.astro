---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PolicyCard from '../components/PolicyCard.astro';
import { policies } from '../data/policies';
---

<Layout
   title="政策｜もっと住みやすい高槻へ"
   description="医療・介護・子育て・まちづくりなど、高槻市をもっと住みやすくするための政策を、公開データと現場経験をもとに提案しています。"
  >
  
  <Header />

  <main class="policy-page">

    <section class="hero">
      <h1>政策</h1>

      <p>
        事実と対話を大切にし、
        データや現場経験をもとに政策を考えています。
      </p>
    </section>
 
     {
       policies.map((policy) => (
         <PolicyCard
           title={policy.category}
           summary={policy.summary}
           href={policy.href}
           available={policy.available}
          />
       ))
     }

  </main>

  <Footer />
</Layout>

<style>
.policy-page{
  max-width:1100px;
  margin:0 auto;
  padding:4rem 2rem;
}

.hero{
  text-align:center;
  margin-bottom:4rem;
}

.coming-soon{
  text-align:center;
  border:1px solid #ddd;
  border-radius:16px;
  padding:3rem;
}
</style>