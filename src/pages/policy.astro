---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PolicyCard from '../components/PolicyCard.astro';
import { policyCategories, type PolicyCategory } from "../data/policyCategories";
import { getCollection } from "astro:content";

// Content Collections から全政策コンテンツを取得
const allPolicies = await getCollection("policies", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// データ整理
const formattedPolicies = allPolicies.map((entry) => {
  const cleanId = entry.id.replace(/\.md$/, "");
  const data = entry.data;

  // md側にtagsが指定されていればそれを優先、無ければ heroTitle をタグにする
  const tagsList = Array.isArray(data.tags) && data.tags.length > 0
    ? data.tags
    : (data.heroTitle ? [data.heroTitle] : []);

  return {
    id: cleanId,
    title: data.title || "",
    summary: data.description || "",
    tags: tagsList,
    href: `policy/${cleanId}/`,
    available: !data.draft,
    category: (data.category || policyCategories[0]) as PolicyCategory,
  };
});

const categoryAnchorMap = {
  "🏥 医療・介護": "medical-care",
  "👨‍👩‍👧 子育て": "childcare",
  "🛡️ 防災": "disaster-prevention",
  "🏙️ 暮らし": "living",
} as const;

const getCategoryAnchor = (categoryName: string) =>
  categoryAnchorMap[categoryName as keyof typeof categoryAnchorMap] ?? categoryName;

// カテゴリーごとのグループ化
const groupedPolicies = policyCategories.map((cat) => {
  return {
    categoryName: cat,
    categoryAnchor: getCategoryAnchor(cat),
    items: formattedPolicies.filter((p) => p.category === cat)
  };
});
---

<Layout
  title="政策｜もっと住みやすい高槻へ"
  description="医療・介護・子育て・まちづくりなど、高槻市をもっと住みやすくするための政策を、公開データと現場経験をもとに提案しています。"
>
  <Header />

  <main class="policy-page container" id="main-content" tabindex="-1">
    <section class="hero">
      <h1>政策</h1>
      <p>
        事実と対話を大切にし、データや現場経験をもとに政策を考えています。
      </p>
      <p>
        現在公開している政策は、今後も皆さまからいただく声や公開資料・データなどを踏まえ、
        必要に応じて見直していきます。<br class="pc-br" />
        「重点政策」は、反響や声の数などを踏まえて指定していきます。
      </p>
    </section>

    <section class="policy-search" aria-labelledby="policy-search-heading">
      <div class="policy-search-header">
        <h2 id="policy-search-heading">政策を探す</h2>
        <p>キーワードから政策を探せます。</p>
      </div>

      <!-- キーワード検索バー -->
      <div class="search-bar">
        <label class="search-label" for="policy-search-input">キーワード検索</label>
        <div class="search-input-group">
          <input
            id="policy-search-input"
            type="search"
            placeholder="例：介護、認知症、暮らし"
            aria-describedby="policy-search-status"
          />
          <button id="policy-search-clear" type="button">クリア</button>
        </div>
      </div>

      <!-- 検索結果件数 -->
      <p class="policy-search-status" id="policy-search-status" role="status" aria-live="polite">
        全 {formattedPolicies.length} 件
      </p>
    </section>

    {
      groupedPolicies
        .filter((group) => group.items.length > 0)
        .map((group) => (
          <section
            id={group.categoryAnchor}
            class="category-section"
            data-category={group.categoryName}
          >
            <h2>{group.categoryName}</h2>

            <div class="cards-grid">
              {
                group.items.map((policy) => (
                  <div
                    class="policy-item"
                    data-search={
                      `${policy.title} ${policy.summary} ${policy.tags.join(" ")}`.toLowerCase()
                    }
                  >
                    <PolicyCard
                      title={policy.title}
                      summary={policy.summary}
                      tags={policy.tags}
                      href={policy.href}
                      available={policy.available}
                    />
                  </div>
                ))
              }
            </div>
          </section>
        ))
    }
  </main>

  <Footer />
</Layout>

<script type="module">
  const searchInput = document.getElementById('policy-search-input');
  const clearKeywordButton = document.getElementById('policy-search-clear');
  const statusElement = document.getElementById('policy-search-status');

  const policyItems = Array.from(document.querySelectorAll('.policy-item'));
  const categorySections = Array.from(document.querySelectorAll('.category-section'));

  const normalize = (value) => (value || '').trim().toLowerCase();

  const updateStatus = () => {
   const visibleCount = policyItems.filter((item) => !item.hidden).length;
   const query = normalize(searchInput.value);

    if (query) {
     statusElement.textContent = `「${searchInput.value.trim()}」の検索結果：${visibleCount} 件`;
    } else {
      statusElement.textContent = `全 ${policyItems.length} 件`;
    }
  };

  const matchesQuery = (item, query) => {
    if (!query) return true;
    const terms = query
      .split(/\s+/)
      .map((value) => value.replace(/^#/, '').trim())
      .filter(Boolean);
    if (terms.length === 0) return true;

    const searchText = item.dataset.search || '';
    return terms.every((term) => searchText.includes(term));
  };

  const filterPolicies = () => {
    const query = normalize(searchInput.value);

    policyItems.forEach((item) => {
      const shouldShow = matchesQuery(item, query);
      item.hidden = !shouldShow;
    });

    categorySections.forEach((section) => {
      const hasVisible = Array.from(section.querySelectorAll('.policy-item')).some(
        (item) => !item.hidden
      );
      section.hidden = !hasVisible;
    });

    updateStatus();
  };

  // キーワード入力クリアボタン
  clearKeywordButton.addEventListener('click', () => {
    searchInput.value = '';
    filterPolicies();
    searchInput.focus();
  });

  // キーワード検索
  searchInput.addEventListener('input', () => {
    filterPolicies();
  });

  // 初期化
  filterPolicies();
</script>

<style>
.policy-page {
  padding-top: 2rem;
  padding-bottom: 3rem;
}

.hero {
  text-align: center;
  margin-bottom: 2rem;
}

.hero p {
  line-height: 1.8;
  color: #444;
}

.policy-search {
  margin-bottom: 2rem;
  border: 1px solid var(--color-border);
  border-radius: 16px;
  padding: 1.25rem 1.5rem;
  background: #fafbfc;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.policy-search-header {
  margin-bottom: 0;
}

.policy-search-header h2 {
  margin: 0 0 0.35rem;
  font-size: 1.25rem;
}

.policy-search-header p {
  margin: 0;
  color: #555;
  font-size: 0.9rem;
}

/* キーワード検索バー */
.search-bar {
  display: grid;
  gap: 0.4rem;
}

.search-label {
  font-weight: 700;
  color: var(--color-party-primary);
  font-size: 0.9rem;
}

.search-input-group {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

#policy-search-input {
  flex: 1;
  min-width: 0;
  padding: 0.65rem 1rem;
  border: 1px solid #d1d5db;
  border-radius: 999px;
  font-size: 0.95rem;
  background: #fff;
  transition: border-color 0.2s, box-shadow 0.2s;
}

#policy-search-input:focus {
  outline: none;
  border-color: var(--color-party-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-party-primary) 15%, transparent);
}

#policy-search-clear {
  padding: 0.65rem 1.25rem;
  border: 1px solid transparent;
  border-radius: 999px;
  background: var(--color-party-primary-subtle);
  color: var(--color-party-primary);
  font-weight: 700;
  font-size: 0.9rem;
  cursor: pointer;
  transition: background 0.15s;
}

#policy-search-clear:hover {
  background: #e8eff9;
}

#policy-search-clear:focus-visible {
  outline: 2px solid var(--color-party-primary);
  outline-offset: 2px;
}

/* 検索ステータス */
.policy-search-status {
  margin: 0;
  font-weight: 700;
  color: #4b5563;
  font-size: 0.9rem;
}

/* 政策カード・カテゴリーセクション */
.category-section {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

.category-section h2 {
  color: var(--color-party-primary);
  border-left: 6px solid var(--color-party-accent);
  padding-left: 1rem;
  margin-bottom: 1.5rem;
  font-size: 1.4rem;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}
</style>