---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PolicyCard from '../components/PolicyCard.astro';
import { policyCategories } from "../data/policyCategories";
import { getCollection } from "astro:content";

// Content Collections から全政策コンテンツを取得
const allPolicies = await getCollection("policies");

// 既存の PolicyCard の表示形式にマッピング
const policies = allPolicies.map((entry) => {
  const cleanId = entry.id.replace(/\.md$/, "");
  return {
    id: cleanId,
    title: entry.data.title,
    summary: entry.data.description,
    tags: [entry.data.heroTitle],
    href: `/policy/${cleanId}`,
    status: "published",
    // もし md 側に category がなければ仮で最初のカテゴリに割り当て
    category: (entry.data as any).category || policyCategories[0],
  };
});

const groupedPolicies = policyCategories.map((category) => ({
  category,
  policies: policies.filter(
    (policy) =>
      policy.category === category &&
      policy.status === "published"
  )
}));
---

<Layout
  title="政策｜もっと住みやすい高槻へ"
  description="医療・介護・子育て・まちづくりなど、高槻市をもっと住みやすくするための政策を、公開データと現場経験をもとに提案しています。"
>
  <Header />

  <main class="policy-page container">
    <section class="hero">
      <h1>政策</h1>
      <p>
        事実と対話を大切にし、<br class="pc-br" />
        データや現場経験をもとに政策を考えています。
      </p>
    </section>

    {
      groupedPolicies
        .filter((group) => group.policies.length > 0)
        .map((group) => (
          <section class="category-section">
            <h2>{group.category}</h2>

            <div class="cards-grid">
              {
                group.policies.map((policy) => (
                  <PolicyCard
                    title={policy.title}
                    summary={policy.summary}
                    tags={policy.tags}
                    href={policy.href}
                    available={policy.status === "published"}
                  />
                ))
              }
            </div>
          </section>
        ))
    }
  </main>

  <Footer />
</Layout>

<style>
.policy-page {
  padding-top: 2rem;
  padding-bottom: 3rem;
}

.hero {
  text-align: center;
  margin-bottom: 2rem;
}

.hero p {
  line-height: 1.8;
  color: #444;
}

.category-section {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

.category-section h2 {
  color: var(--color-primary);
  border-left: 6px solid var(--color-accent);
  padding-left: 1rem;
  margin-bottom: 1.5rem;
  font-size: 1.4rem;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.pc-br {
  display: none;
}

@media (min-width: 768px) {
  .pc-br {
    display: inline;
  }
}
</style>