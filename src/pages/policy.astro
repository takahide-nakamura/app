---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PolicyCard from '../components/PolicyCard.astro';
import { policyCategories, type PolicyCategory } from "../data/policyCategories";
import { getPolicyTagMeta } from "../data/policyTags";
import { getCollection } from "astro:content";

// Content Collections から全政策コンテンツを取得
const allPolicies = await getCollection("policies", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// データ整理
const formattedPolicies = allPolicies.map((entry) => {
  const cleanId = entry.id.replace(/\.md$/, "");
  const data = entry.data;

  // md側にtagsが指定されていればそれを優先、無ければ heroTitle をタグにする
  const tagsList = Array.isArray(data.tags) && data.tags.length > 0
    ? data.tags
    : (data.heroTitle ? [data.heroTitle] : []);

  return {
    id: cleanId,
    title: data.title || "",
    summary: data.description || "",
    tags: tagsList,
    href: `policy/${cleanId}/`,
    status: "published",
    category: (data.category || policyCategories[0]) as PolicyCategory,
  };
});

// 実際に政策で使用されている全タグを抽出し、辞書からメタ情報を付与（未使用タグは除外）
const usedTagsMap = new Map<
  string,
  { name: string; reading: string; category: PolicyCategory | "all"; featured?: boolean }
>();

formattedPolicies.forEach((policy) => {
  policy.tags.forEach((tag) => {
    if (!usedTagsMap.has(tag)) {
      const meta = getPolicyTagMeta(tag, policy.category);
      usedTagsMap.set(tag, {
        name: tag,
        reading: meta.reading,
        category: meta.category,
        featured: meta.featured,
      });
    }
  });
});

// 注目タグ（featured: true かつ 実際に政策で使用されているもの）
const featuredTags = Array.from(usedTagsMap.values())
  .filter((t) => t.featured)
  .sort((a, b) => a.reading.localeCompare(b.reading, "ja"));

// カテゴリーごとにタグをグループ化
// "all" カテゴリーのタグ（#重点政策）は全カテゴリーに含め、各カテゴリー内でも先頭に配置
const categoryTagGroups = policyCategories.map((cat) => {
  const tagsInCat = Array.from(usedTagsMap.values())
    .filter((t) => t.category === "all" || t.category === cat)
    .sort((a, b) => {
      // 注目タグ（重点政策など）を先頭に、それ以外は読み仮名順
      if (a.featured && !b.featured) return -1;
      if (!a.featured && b.featured) return 1;
      return a.reading.localeCompare(b.reading, "ja");
    });

  return {
    categoryName: cat,
    tags: tagsInCat,
  };
}).filter((group) => group.tags.length > 0);

const categoryAnchorMap = {
  "🏥 医療・介護": "medical-care",
  "👨‍👩‍👧 子育て": "childcare",
  "🛡️ 防災": "disaster-prevention",
  "🏙️ 暮らし": "living",
} as const;

const getCategoryAnchor = (categoryName: string) =>
  categoryAnchorMap[categoryName as keyof typeof categoryAnchorMap] ?? categoryName;

// カテゴリーごとのグループ化
const groupedPolicies = policyCategories.map((cat) => {
  return {
    categoryName: cat,
    categoryAnchor: getCategoryAnchor(cat),
    items: formattedPolicies.filter((p) => p.category === cat)
  };
});
---

<Layout
  title="政策｜もっと住みやすい高槻へ"
  description="医療・介護・子育て・まちづくりなど、高槻市をもっと住みやすくするための政策を、公開データと現場経験をもとに提案しています。"
>
  <Header />

  <main class="policy-page container" id="main-content" tabindex="-1">
    <section class="hero">
      <h1>政策</h1>
      <p>
        事実と対話を大切にし、<br class="pc-br" />
        データや現場経験をもとに政策を考えています。
      </p>
    </section>

    <section class="policy-search" aria-labelledby="policy-search-heading">
      <div class="policy-search-header">
        <h2 id="policy-search-heading">政策を探す</h2>
        <p>キーワード検索とタグ絞り込みで、政策をすばやく見つけられます。</p>
      </div>

      <!-- 1. キーワード検索バー -->
      <div class="search-bar">
        <label class="search-label" for="policy-search-input">キーワード検索</label>
        <div class="search-input-group">
          <input
            id="policy-search-input"
            type="search"
            placeholder="例：介護、認知症、暮らし"
            aria-describedby="policy-search-status"
          />
          <button id="policy-search-clear" type="button">クリア</button>
        </div>
      </div>

      <!-- 2. 🌟 注目の政策（真っ先に着目できるエリア：常時コンパクトに表示） -->
      {
        featuredTags.length > 0 && (
          <div class="featured-tags-box" aria-label="注目の政策タグ">
            <span class="featured-tags-label">
              <span class="featured-icon" aria-hidden="true"></span> 注目の政策：
            </span>
            <div class="featured-tags-list">
              {featuredTags.map((tag) => (
                <button
                  type="button"
                  class="tag-button featured-tag-button"
                  data-tag={tag.name}
                  data-reading={tag.reading}
                  aria-pressed="false"
                >
                  <span class="featured-pill-star" aria-hidden="true">★</span>
                  #{tag.name}
                </button>
              ))}
            </div>
          </div>
        )
      }

      <!-- 3. 選択中タグ表示バー（タグ選択時のみ動的表示。未選択時は完全に非表示） -->
      <div class="active-filter-bar" id="active-filter-bar" hidden>
        <div class="active-filter-header">
          <span class="active-filter-label">絞り込み中のタグ（いずれかを含む政策を表示）：</span>
          <button type="button" class="clear-all-button" id="clear-all-filters">
            すべての絞り込みを解除
          </button>
        </div>
        <div class="active-chips-list" id="active-chips-list"></div>
      </div>

      <!-- 4. テーマ・タグから探す（普段は小さく折りたたんで省スペース化） -->
      <details class="tag-filter-accordion" id="tag-filter-accordion">
        <summary class="tag-filter-summary">
          <div class="summary-title-group">
            <span class="summary-icon" aria-hidden="true">🏷️</span>
            <span class="summary-title">カテゴリー・全タグから探す（複数選択可）</span>
            <span class="active-tag-count-badge" id="active-tag-count-badge" hidden></span>
          </div>
          <span class="summary-toggle-indicator">
            <span class="toggle-text">タグ一覧</span>
            <span class="summary-arrow" aria-hidden="true">▼</span>
          </span>
        </summary>

        <div class="tag-filter-panel">
          <div class="tag-search-row">
            <label class="sr-only" for="tag-search-input">タグを検索（名前または読み仮名）</label>
            <input
              id="tag-search-input"
              type="search"
              placeholder="タグを検索（例：介護、にんち、ほいく）"
              autocomplete="off"
            />
          </div>

          <!-- カテゴリー別折りたたみ (<details> / <summary>) -->
          <div class="tag-categories-list" id="tag-categories-list">
            {
              categoryTagGroups.map((group) => (
                <details class="tag-category-group" data-category={group.categoryName}>
                  <summary class="tag-category-summary">
                    <span class="category-summary-title">{group.categoryName}</span>
                    <span class="category-summary-count">（{group.tags.length}）</span>
                    <span class="category-summary-icon" aria-hidden="true">▼</span>
                  </summary>
                  <div class="tag-buttons-container">
                    <div class="tag-buttons-list" role="group" aria-label={`${group.categoryName}のタグ一覧`}>
                      {group.tags.map((tag) => (
                        <button
                          type="button"
                          class:list={[
                            "tag-button",
                            tag.featured ? "category-featured-tag" : ""
                          ]}
                          data-tag={tag.name}
                          data-reading={tag.reading}
                          aria-pressed="false"
                        >
                          {tag.featured && <span class="featured-star-small" aria-hidden="true">★</span>}
                          #{tag.name}
                        </button>
                      ))}
                    </div>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </details>

      <!-- 5. 検索ステータス -->
      <p class="policy-search-status" id="policy-search-status" role="status" aria-live="polite">
        全 {formattedPolicies.length} 件
      </p>
    </section>

    {
      groupedPolicies
        .filter((group) => group.items.length > 0)
        .map((group) => (
          <section
            id={group.categoryAnchor}
            class="category-section"
            data-category={group.categoryName}
          >
            <h2>{group.categoryName}</h2>

            <div class="cards-grid">
              {
                group.items.map((policy) => (
                  <div
                    class="policy-item"
                    data-category={policy.category}
                    data-tags={policy.tags.join("|")}
                    data-search={
                      `${policy.title} ${policy.summary} ${policy.tags.join(" ")}`.toLowerCase()
                    }
                  >
                    <PolicyCard
                      title={policy.title}
                      summary={policy.summary}
                      tags={policy.tags}
                      href={policy.href}
                      available={policy.status === "published"}
                    />
                  </div>
                ))
              }
            </div>
          </section>
        ))
    }
  </main>

  <Footer />
</Layout>

<script type="module">
  const searchInput = document.getElementById('policy-search-input');
  const clearKeywordButton = document.getElementById('policy-search-clear');
  const statusElement = document.getElementById('policy-search-status');

  const tagSearchInput = document.getElementById('tag-search-input');
  const tagButtons = Array.from(document.querySelectorAll('.tag-button'));
  const tagCategories = Array.from(document.querySelectorAll('.tag-category-group'));
  const activeTagCountBadge = document.getElementById('active-tag-count-badge');

  const activeFilterBar = document.getElementById('active-filter-bar');
  const activeChipsList = document.getElementById('active-chips-list');
  const clearAllFiltersButton = document.getElementById('clear-all-filters');

  const policyItems = Array.from(document.querySelectorAll('.policy-item'));
  const categorySections = Array.from(document.querySelectorAll('.category-section'));

  // 複数タグ選択管理用の Set（OR検索）
  const activeTags = new Set();

  const normalize = (value) => (value || '').trim().toLowerCase();

  // カタカナをひらがなに変換（ひらがな・カタカナ両対応）
  const toHiragana = (str) => {
    return (str || '').replace(/[\u30a1-\u30f6]/g, (match) => {
      const chr = match.charCodeAt(0) - 0x60;
      return String.fromCharCode(chr);
    });
  };

  const updateStatus = () => {
    const visibleCount = policyItems.filter((item) => !item.hidden).length;
    const query = normalize(searchInput.value);
    const tagsArray = Array.from(activeTags);

    if (query && tagsArray.length > 0) {
      const tagsText = tagsArray.map((t) => `#${t}`).join(' または ');
      statusElement.textContent = `「${searchInput.value.trim()}」かつ [${tagsText}] のいずれか：${visibleCount} 件`;
    } else if (tagsArray.length > 0) {
      const tagsText = tagsArray.map((t) => `#${t}`).join(' または ');
      statusElement.textContent = `[${tagsText}] のいずれか：${visibleCount} 件`;
    } else if (query) {
      statusElement.textContent = `「${searchInput.value.trim()}」の検索結果：${visibleCount} 件`;
    } else {
      statusElement.textContent = `全 ${policyItems.length} 件`;
    }
  };

  const matchesQuery = (item, query) => {
    if (!query) return true;
    const terms = query
      .split(/\s+/)
      .map((value) => value.replace(/^#/, '').trim())
      .filter(Boolean);
    if (terms.length === 0) return true;

    const searchText = item.dataset.search || '';
    return terms.every((term) => searchText.includes(term));
  };

  // タグのOR検索判定：選択中のタグのいずれか1つでも持っていればマッチ
  const matchesTags = (item, tagsSet) => {
    if (tagsSet.size === 0) return true;
    const itemTags = (item.dataset.tags || '').split('|').map((v) => v.trim());
    for (const tag of tagsSet) {
      if (itemTags.includes(tag)) {
        return true;
      }
    }
    return false;
  };

  const filterPolicies = () => {
    const query = normalize(searchInput.value);

    policyItems.forEach((item) => {
      const shouldShow = matchesQuery(item, query) && matchesTags(item, activeTags);
      item.hidden = !shouldShow;
    });

    categorySections.forEach((section) => {
      const hasVisible = Array.from(section.querySelectorAll('.policy-item')).some(
        (item) => !item.hidden
      );
      section.hidden = !hasVisible;
    });

    updateStatus();
  };

  // タグ選択状態のUI反映（複数チップの動的生成 ＆ ボタン状態の同期）
  const renderActiveTagsUI = () => {
    if (activeTags.size > 0) {
      activeFilterBar.hidden = false;
      activeChipsList.innerHTML = '';

      activeTags.forEach((tag) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'active-tag-chip';
        chip.setAttribute('aria-label', `${tag}の絞り込みを解除`);
        chip.title = `${tag}の絞り込みを解除`;
        chip.innerHTML = `
          <span class="chip-text">#${tag}</span>
          <span class="chip-remove" aria-hidden="true">✕</span>
        `;
        chip.addEventListener('click', () => {
          removeActiveTag(tag);
        });
        activeChipsList.appendChild(chip);
      });

      if (activeTagCountBadge) {
        activeTagCountBadge.hidden = false;
        activeTagCountBadge.textContent = `${activeTags.size}件選択中`;
      }
    } else {
      activeFilterBar.hidden = true;
      activeChipsList.innerHTML = '';

      if (activeTagCountBadge) {
        activeTagCountBadge.hidden = true;
        activeTagCountBadge.textContent = '';
      }
    }

    // 全タグボタンの選択状態を更新（最上部およびアコーディオン内すべて同期）
    tagButtons.forEach((btn) => {
      const isSelected = activeTags.has(btn.dataset.tag);
      btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      btn.classList.toggle('is-selected', isSelected);
    });
  };

  const toggleActiveTag = (tag) => {
    if (activeTags.has(tag)) {
      activeTags.delete(tag);
    } else {
      activeTags.add(tag);
    }
    renderActiveTagsUI();
    filterPolicies();
  };

  const removeActiveTag = (tag) => {
    activeTags.delete(tag);
    renderActiveTagsUI();
    filterPolicies();
  };

  const clearAll = () => {
    searchInput.value = '';
    activeTags.clear();
    renderActiveTagsUI();
    filterPolicies();
    searchInput.focus();
  };

  // タグボタンのクリック（トグル：複数選択対応）
  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      toggleActiveTag(btn.dataset.tag);
    });
  });

  // すべてクリアボタン
  clearAllFiltersButton.addEventListener('click', () => {
    clearAll();
  });

  // キーワード入力クリアボタン
  clearKeywordButton.addEventListener('click', () => {
    searchInput.value = '';
    filterPolicies();
    searchInput.focus();
  });

  // キーワード検索（タグを解除しない：AND検索）
  searchInput.addEventListener('input', () => {
    filterPolicies();
  });

  // タグ検索（リアルタイム絞り込み）
  tagSearchInput.addEventListener('input', () => {
    const rawValue = tagSearchInput.value.trim();
    const query = normalize(rawValue);
    const queryHira = toHiragana(query);

    if (!query) {
      tagButtons.forEach((btn) => {
        btn.hidden = false;
      });
      tagCategories.forEach((group) => {
        group.hidden = false;
      });
      return;
    }

    tagCategories.forEach((group) => {
      const buttonsInGroup = Array.from(group.querySelectorAll('.tag-button'));
      let visibleCountInGroup = 0;

      buttonsInGroup.forEach((btn) => {
        const tagName = normalize(btn.dataset.tag || '');
        const reading = normalize(btn.dataset.reading || '');
        const tagNameHira = toHiragana(tagName);

        const matched =
          tagName.includes(query) ||
          reading.includes(query) ||
          reading.includes(queryHira) ||
          tagNameHira.includes(queryHira);

        btn.hidden = !matched;
        if (matched) visibleCountInGroup++;
      });

      if (visibleCountInGroup > 0) {
        group.hidden = false;
        group.open = true; // マッチするタグがあるカテゴリーは自動展開
      } else {
        group.hidden = true;
      }
    });
  });

  // 初期化
  renderActiveTagsUI();
  filterPolicies();
</script>

<style>
.policy-page {
  padding-top: 2rem;
  padding-bottom: 3rem;
}

.hero {
  text-align: center;
  margin-bottom: 2rem;
}

.hero p {
  line-height: 1.8;
  color: #444;
}

.policy-search {
  margin-bottom: 2rem;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: 16px;
  padding: 1.25rem 1.5rem;
  background: #fafbfc;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.policy-search-header {
  margin-bottom: 0;
}

.policy-search-header h2 {
  margin: 0 0 0.35rem;
  font-size: 1.25rem;
}

.policy-search-header p {
  margin: 0;
  color: #555;
  font-size: 0.9rem;
}

/* キーワード検索バー */
.search-bar {
  display: grid;
  gap: 0.4rem;
}

.search-label {
  font-weight: 700;
  color: var(--color-primary, #003f88);
  font-size: 0.9rem;
}

.search-input-group {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

#policy-search-input {
  flex: 1;
  min-width: 0;
  padding: 0.65rem 1rem;
  border: 1px solid #d1d5db;
  border-radius: 999px;
  font-size: 0.95rem;
  background: #fff;
  transition: border-color 0.2s, box-shadow 0.2s;
}

#policy-search-input:focus {
  outline: none;
  border-color: var(--color-primary, #003f88);
  box-shadow: 0 0 0 3px rgba(0, 63, 136, 0.15);
}

#policy-search-clear {
  padding: 0.65rem 1.25rem;
  border: 1px solid transparent;
  border-radius: 999px;
  background: var(--color-accent, #f4f7fb);
  color: var(--color-primary, #003f88);
  font-weight: 700;
  font-size: 0.9rem;
  cursor: pointer;
  transition: background 0.15s;
}

#policy-search-clear:hover {
  background: #e8eff9;
}

#policy-search-clear:focus-visible {
  outline: 2px solid var(--color-primary, #003f88);
  outline-offset: 2px;
}

/* 🌟 注目タグエリア（コンパクト＆真っ先に目立つ） */
.featured-tags-box {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.6rem;
  background: #fffdf5;
  border: 1px solid #f6e05e;
  border-left: 4px solid var(--color-accent, #fabe00);
  border-radius: 8px;
  padding: 0.5rem 0.85rem;
}

.featured-tags-label {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-weight: 700;
  font-size: 0.85rem;
  color: #744210;
  white-space: nowrap;
}

.featured-icon {
  color: #d97706;
  font-size: 0.9rem;
}

.featured-tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.featured-tag-button {
  background: #ffffff;
  border: 1.5px solid var(--color-accent, #fabe00);
  color: var(--color-primary, #003f88);
  font-weight: 700;
  padding: 0.3rem 0.75rem;
  font-size: 0.85rem;
  box-shadow: 0 1px 2px rgba(250, 190, 0, 0.15);
}

.featured-tag-button:hover {
  background: #fffbeb;
  border-color: #d97706;
}

.featured-pill-star {
  color: #d97706;
  margin-right: 0.2rem;
  font-size: 0.75rem;
}

.category-featured-tag {
  border-color: #f6e05e;
  background: #fffdfa;
  font-weight: 700;
  color: var(--color-primary, #003f88);
}

.featured-star-small {
  color: #d97706;
  margin-right: 0.2rem;
  font-size: 0.75rem;
}

/* 絞り込み中タグの表示バー（未選択時は完全に非表示） */
.active-filter-bar {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  background: #eef4fc;
  border: 1px solid #bfdbfe;
  border-radius: 8px;
  padding: 0.65rem 0.85rem;
}

/* hidden属性がついているときは絶対に表示しない */
.active-filter-bar[hidden] {
  display: none !important;
}

.active-filter-header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
}

.active-filter-label {
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--color-primary, #003f88);
}

.active-chips-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

:global(.active-tag-chip) {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.3rem 0.75rem;
  background: var(--color-primary, #003f88);
  color: #ffffff;
  border: 1px solid var(--color-primary, #003f88);
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
  line-height: 1.4;
}

:global(.active-tag-chip:hover) {
  background: #002b5e;
  border-color: #002b5e;
}

:global(.active-tag-chip:focus-visible) {
  outline: 2px solid var(--color-accent, #fabe00);
  outline-offset: 2px;
}

:global(.chip-text) {
  font-size: 0.85rem;
}

:global(.chip-remove) {
  font-size: 0.75rem;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  width: 1.15rem;
  height: 1.15rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin-left: 0.15rem;
  transition: background 0.15s;
}

:global(.active-tag-chip:hover .chip-remove) {
  background: rgba(255, 255, 255, 0.4);
}

.clear-all-button {
