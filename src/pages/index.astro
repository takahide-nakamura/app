---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PolicyPreview from '../components/PolicyPreview.astro';
import ActivityPreview from '../components/ActivityPreview.astro';
import AboutSite from '../components/AboutSite.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from "../components/SocialLinks.astro";
---

<Layout
  title="もっと住みやすい高槻へ"
  description="理学療法士としての現場経験と公開データをもとに、高槻市の医療・介護・子育て・まちづくりについて政策を提案しています。"
>
  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />

    <AboutSite />

    <PolicyPreview />

    <CategoryGrid />

    <ActivityPreview />

    <section class="social-media-section">
      <div class="social-media-inner">
        <h2>動画・SNSでも発信しています</h2>

        <p>
         政策の背景や考え方を、動画やSNSでも発信しています。
        </p>

       <SocialLinks />
      </div>
    </section>

    <ContactCTA />

  </main>

  <Footer />
</Layout>

<style>
main {
  width: 100%;
}
</style>