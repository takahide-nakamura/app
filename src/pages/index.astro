---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PolicyPreview from '../components/PolicyPreview.astro';
import ActivityPreview from '../components/ActivityPreview.astro';
import Footer from '../components/Footer.astro';
---

<Layout
   title="もっと住みやすい高槻へ"
   description="理学療法士としての現場経験と公開データをもとに、高槻市の医療・介護・子育て・まちづくりについて政策を提案しています。"
  >
  
  <Header />
  <main>
   <Hero />
   <PolicyPreview />
   <ActivityPreview />
  </main>
    <Footer />
</Layout>

<style>
main {
  display: grid;
  place-items: center;
  min-height: 80vh;
  padding: 2rem;
}
</style>