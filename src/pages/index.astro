---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout>
  <Header />
  <main>
    <section class="hero">
      <h1>もっと住みやすい高槻へ</h1>

      <p>
        事実に向き合い、市民の皆さんとの対話を重ね、
        もっと住みやすい高槻をつくる。
      </p>

      <div class="buttons">
        <a href="/policy" class="btn btn-primary">政策を見る</a>
        <a href="/activity" class="btn btn-outline">活動を見る</a>
      </div>
    </section>
  </main>
</Layout>

<style>
main {
  display: grid;
  place-items: center;
  min-height: 80vh;
  padding: 2rem;
}

.hero {
  max-width: 760px;
  text-align: center;
}

.hero h1 {
}

.hero p {
  font-size: 1.2rem;
  margin-bottom: 2rem;
}

.buttons {
  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}


</style>