---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
---

<Layout
  title="お問い合わせ・市民の声｜もっと住みやすい高槻へ"
  description="サイトや活動についてのお問い合わせ、高槻市の暮らし・地域・市政についてのご意見をお寄せいただけます。"
>
  <Header />

  <main class="contact-page page-content" id="main-content" tabindex="-1">

    <section class="hero">
      <h1>お問い合わせ・市民の声</h1>

      <p>
        お問い合わせや、高槻市の暮らし・地域・市政についてのご意見をお寄せいただけます。
      </p>
    </section>

    <div class="intake-grid">
      <section class="intake-card">
        <h2>お問い合わせ</h2>

        <p>
          サイトや活動についてのご質問、取材・面談などのご連絡はこちらからお送りください。
        </p>

        <a
          href="https://docs.google.com/forms/d/e/1FAIpQLSfXDAjwfrAEvMAlWmqZOgG_8VhfAMFAV1ktnTBdeLRZajAe2g/viewform?usp=dialog"
          class="form-btn"
          target="_blank"
          rel="noopener noreferrer"
        >お問い合わせフォームを開く</a>
      </section>

      <section class="intake-card">
        <h2>市民の声</h2>

        <p>
          高槻市での日常の困りごとや、地域・市政についてのご意見やご提案をお寄せください。
        </p>

        <p>送信前に「市民の声の運用ルール」をご確認ください。</p>

        <a href={`${base}opinions/rules/`} class="form-btn">市民の声を送る</a>
      </section>
    </div>

    <section class="opinions-link-section">
      <h2>市民の声・対応状況</h2>

      <p>
        皆様から寄せられたご意見と、それに対する取り組みの進捗状況を公開しています。
      </p>

      <a href={`${base}opinions/`} class="opinions-btn">
        市民の声・対応状況一覧を見る
      </a>
    </section>

    <!-- SNS -->
    <section class="sns">
      <h2>SNS</h2>

      <p>
        YouTubeやXでも情報発信を行っています。
      </p>

      <ul>
        <li>YouTube（準備中）</li>
        <li>X（準備中）</li>
      </ul>
    </section>

  </main>

  <Footer />
</Layout>

<style>
.contact-page {
  padding: clamp(2rem, 4vw, 4rem) 0;
}

.hero {
  text-align: center;
  margin-bottom: 4rem;
}

.contact-page section {
  margin-bottom: 3rem;
}

.contact-page h2 {
  color: #003f88;
  margin-bottom: 1rem;
}

.intake-card,
.opinions-link-section,
.sns {
  border: 1px solid #ddd;
  border-radius: 16px;
  padding: 2rem;
  background: #fff;
}

.intake-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.intake-card {
  display: flex;
  flex-direction: column;
}

.intake-card p:last-of-type {
  margin-bottom: 1.5rem;
}

.intake-card .form-btn {
  align-self: flex-start;
  margin-top: auto;
}

/* フォーム送信ボタンのスタイル */
.form-btn {
  display: inline-block;
  background: #003f88;
  color: #fff;
  padding: 1rem 1.8rem;
  border-radius: 8px;
  font-weight: bold;
  text-decoration: none;
  transition: background 0.2s ease;
  min-height: 2.75rem;
}

.form-btn:hover {
  background: #002b5c;
}

/* 対応状況ページリンクボタンのスタイル */
.opinions-btn {
  display: inline-block;
  background: #f0f7ff;
  color: #003f88;
  border: 2px solid #003f88;
  padding: 0.8rem 1.5rem;
  border-radius: 8px;
  font-weight: bold;
  text-decoration: none;
  transition: all 0.2s ease;
}

.opinions-btn:hover {
  background: #003f88;
  color: #fff;
}

@media (max-width: 700px) {
  .intake-grid {
    grid-template-columns: 1fr;
  }
}
</style>