---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
---

<Layout
  title="お問い合わせ・市民の声｜もっと住みやすい高槻へ"
  description="高槻市での日常のお困りごとやご意見をお寄せください。"
>
  <Header />

  <main class="contact-page page-content" id="main-content" tabindex="-1">

    <section class="hero">
      <h1>お問い合わせ・市民の声</h1>

      <p>
        高槻市での日常の「困りごと」や「ご提案」をお寄せください。<br />
        いただいた声は、今後の活動や政策づくりに活用させていただきます。
      </p>
    </section>

    <!-- Googleフォームへの誘導 -->
    <section class="contact-method">
      <h2>ご意見・お困りごとの送信</h2>

      <p>
          ご意見を送る前に、市民の声の運用ルールをご確認ください。<br />
          お名前や連絡先の記入は任意です。
      </p>

      <!-- ボタンリンク（Googleフォームを開く） -->
      <div style="margin-top: 1.5rem;">
          <a href={`${base}opinions/rules/`} class="form-btn">
           ルールを確認して
           ご意見・お困りごとの送信する
        </a>
      </div>
    </section>

    <!-- 市民の声・対応状況ページへの誘導カード -->
    <section class="opinions-link-section">
      <h2>市民の声・対応状況の公開</h2>

      <p>
        皆様から寄せられたご意見と、それに対する取り組みの進捗状況を公開しています。
      </p>

      <div style="margin-top: 1.5rem;">
        <a href={`${base}opinions/`} class="opinions-btn">
          💬 「市民の声・対応状況一覧」を見る
        </a>
      </div>
    </section>

    <!-- SNS -->
    <section class="sns">
      <h2>SNS</h2>

      <p>
        YouTubeやXでも情報発信を行っています。
      </p>

      <ul>
        <li>YouTube（準備中）</li>
        <li>X（準備中）</li>
      </ul>
    </section>

    <!-- 注意事項 -->
    <section class="notice">
      <h2>プライバシーとお願い</h2>

      <p>
        いただいたご意見は政策立案に活用させていただきます。<br />
        詳しくは「市民の声の運用ルール」をご確認ください。
      </p>
    </section>

  </main>

  <Footer />
</Layout>

<style>
.contact-page {
  padding: clamp(2rem, 4vw, 4rem) 0;
}

.hero {
  text-align: center;
  margin-bottom: 4rem;
}

.contact-page section {
  margin-bottom: 3rem;
}

.contact-page h2 {
  color: #003f88;
  margin-bottom: 1rem;
}

.contact-method,
.opinions-link-section,
.sns,
.notice {
  border: 1px solid #ddd;
  border-radius: 16px;
  padding: 2rem;
  background: #fff;
}

/* フォーム送信ボタンのスタイル */
.form-btn {
  display: inline-block;
  background: #003f88;
  color: #fff;
  padding: 1rem 1.8rem;
  border-radius: 8px;
  font-weight: bold;
  text-decoration: none;
  transition: background 0.2s ease;
}

.form-btn:hover {
  background: #002b5c;
}

/* 対応状況ページリンクボタンのスタイル */
.opinions-btn {
  display: inline-block;
  background: #f0f7ff;
  color: #003f88;
  border: 2px solid #003f88;
  padding: 0.8rem 1.5rem;
  border-radius: 8px;
  font-weight: bold;
  text-decoration: none;
  transition: all 0.2s ease;
}

.opinions-btn:hover {
  background: #003f88;
  color: #fff;
}
</style>