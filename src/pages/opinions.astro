---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { opinionPublicCsvUrl } from '../data/opinionForm';
import { getBaseUrl } from '../lib/siteUrl';

const CSV_URL = opinionPublicCsvUrl;
const base = getBaseUrl();

interface Opinion {
  id: string;
  date: string;
  category: string;
  area: string;
  text: string;
  status: string;
  summary: string;
  comment: string;
  policyId: string;
  policyLink: { href: string; label: string } | null;
}

// 公開中の政策スラッグ一覧（関連政策IDが実在する政策を指す場合の判定用）
const publishedPolicies = await getCollection('policies', ({ data }) => !data.draft);
const publishedPolicySlugs = new Set(
  publishedPolicies.map((entry) => entry.id.replace(/\.md$/, ''))
);

// 市民の声システムが出力するカテゴリID → 政策一覧のカテゴリセクションへのリンク
const categoryPolicyLinks: Record<string, { href: string; label: string }> = {
  'policy-life': { href: 'policy#living', label: '🔗 暮らしの政策を見る' },
  'policy-medical': { href: 'policy#medical-care', label: '🔗 医療・介護の政策を見る' },
  'policy-disaster': { href: 'policy#disaster-prevention', label: '🔗 防災の政策を見る' },
  'policy-childcare': { href: 'policy#childcare', label: '🔗 子育ての政策を見る' },
  'policy-other': { href: 'policy', label: '🔗 政策一覧を見る' },
};

// 関連政策IDをリンクに解決する。
// 実在する政策スラッグならその政策ページへ、カテゴリIDなら政策一覧の該当カテゴリへ。
// どちらでもない場合はリンクを出さない（リンク切れ防止）。
function resolvePolicyLink(policyId: string): { href: string; label: string } | null {
  if (!policyId) {
    return null;
  }

  if (publishedPolicySlugs.has(policyId)) {
    return { href: `policy/${policyId}`, label: '🔗 関連する政策を見る' };
  }

  return categoryPolicyLinks[policyId] ?? null;
}

function getStatusIcon(status: string) {
  switch (status) {
    case "受付済み":
      return "📩";

    case "確認中":
      return "🔎";

    case "調査・検討中":
      return "📝";

    case "対応中":
      return "🔧";

    case "対応完了":
      return "✅";

    case "対応困難":
      return "⚠️";

    default:
      return "📌";
  }
}



let opinions: Opinion[] = [];

// CSVを正しく読み込むための簡易パーサー
function parseCSVLine(line: string): string[] {
  const result: string[] = [];
  let current = '';
  let inQuotes = false;

  for (let i = 0; i < line.length; i++) {
    const char = line[i];

    if (char === '"') {
      if (inQuotes && line[i + 1] === '"') {
        current += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
    } else if (char === ',' && !inQuotes) {
      result.push(current.trim());
      current = '';
    } else {
      current += char;
    }
  }

  result.push(current.trim());

  return result;
}

try {
  const res = await fetch(CSV_URL);

  if (res.ok) {
    const csvText = await res.text();

    const lines = csvText
      .split(/\r?\n/)
      .filter(line => line.trim() !== '');

    // 1行目はヘッダー
    opinions = lines
      .slice(1)
      .map(line => {
        const cols = parseCSVLine(line);

        return {
         id: cols[0] || '',
         date: cols[1] || '',
         category: cols[2] || 'その他',
         area: cols[3] || '高槻市内',
         text: cols[4] || '',
         status: cols[5] || '受付済み',
         summary: cols[6] || '',
         comment: cols[7] || '',
         policyId: cols[8] || '',
         policyLink: resolvePolicyLink(cols[8] || '')
        };
      })
      .filter(item => item.text);
  }
} catch (e) {
  console.error('市民の声データ取得エラー:', e);
}
---

<Layout
  title="市民の声・対応状況｜もっと住みやすい高槻へ"
  description="皆様から寄せられたお困りごとやご意見と、それに対する取り組みの対応状況を公開しています。"
>

  <Header />

  <main id="main-content" tabindex="-1">
    <section class="hero">
      <h1>市民の声・対応状況</h1>

      <p>
        皆様から寄せられた高槻市でのお困りごとやご意見と、
        それに対する取り組みの対応状況を公開しています。
      </p>
    </section>

    <section class="opinions-section">
     <h2>市民の声</h2>
        <div class="rules-notice">
          <p>ご意見を送る前に、市民の声の運用ルールをご確認ください。</p>
          <a href={`${base}opinions/rules/`} class="rules-link">
            市民の声の運用ルールを確認する
          </a>
        </div>

      <!-- カテゴリフィルター -->
      <div class="category-filter">
        <button type="button" data-category="all" class="filter-btn active">
         すべて
        </button>

        <button type="button" data-category="暮らし" class="filter-btn">
         暮らし
        </button>

        <button type="button" data-category="医療・介護" class="filter-btn">
         医療・介護
        </button>

        <button type="button" data-category="防災" class="filter-btn">
         防災
        </button>

        <button type="button" data-category="子育て" class="filter-btn">
         子育て
        </button>

        <button type="button" data-category="その他" class="filter-btn">
         その他
        </button>
      </div>

      {opinions.length === 0 ? (
        <div class="empty-state">
          現在、表示できるご意見・ご要望はありません。
        </div>
      ) : (
        <div class="opinions-list">
          {opinions.map(item => (
            <article
              class="opinion-card"
              data-category={item.category}
            >

              <div class="card-header">
                <span class="opinion-id">
                  {item.id}
                </span>

                <span class="date">
                  {item.date}
                </span>
              </div>

              <div class="card-tags">
                <span class={`status-tag status-${item.status}`}>
                  {getStatusIcon(item.status)}
                  {item.status}
                </span>

                <span class="category-tag">
                  {item.category}
                </span>

                <span class="area-tag">
                  📍 {item.area}
                </span>
              </div>

              <p class="opinion-text">
                {item.text}
              </p>

              {item.summary && (
                <div class="summary-box">
                  💡 <strong>ポイント:</strong> {item.summary}
                </div>
              )}

              {item.comment && (
                <div class="response-box">
                 <strong>📢 対応状況</strong>
                 <p>{item.comment}</p>
                </div>
              )}

              {item.policyLink && (
                <div class="policy-link-box">
                  <a href={`${base}${item.policyLink.href}`}>
                   {item.policyLink.label}
                  </a>
                </div>
              )}

            </article>
          ))}
        </div>
      )}
    </section>
  </main>
  <Footer />

</Layout>

<style>
  .hero {
    padding: clamp(2rem, 4vw, 3rem) 0 0;
    text-align: center;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .hero p {
    line-height: 1.8;
  }

  .opinions-section {
    width: min(100% - 2rem, var(--container-width));
    max-width: var(--container-width);
    margin-inline: auto;
    padding: 0 0 4rem;
  }

  .opinions-section h2 {
    margin-bottom: 1.5rem;
  }

  .opinions-list {
    display: grid;
    gap: 1.5rem;
  }

  .category-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: 2rem;
}

.filter-btn {
  padding: 0.55rem 1rem;
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-full);
  background: var(--color-background);
  color: var(--color-text);
  cursor: pointer;
  font-size: var(--text-base);
}

.filter-btn:hover {
  opacity: 0.8;
}

.filter-btn.active {
  background: var(--color-party-primary);
  color: var(--color-text-inverse);
  border-color: var(--color-party-primary);
}

  .opinion-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-background);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .opinion-id {
    font-weight: 600;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .card-tags span {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
  }

  .status-受付済み {
   background: var(--color-party-primary);
   color: white;
 }

  .rules-notice {
    margin: 0 0 2rem;
    padding: 1.5rem;
    border: 1px solid var(--color-party-primary-border);
    border-radius: var(--radius-md);
    background: var(--color-party-primary-subtle);
  }

  .rules-notice p {
    margin-bottom: 1rem;
  }

  .rules-link {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--color-party-primary);
    border-radius: var(--radius-md);
    color: var(--color-party-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .rules-link:hover {
    background: var(--color-party-primary);
    color: var(--color-text-inverse);
  }

  .status-確認中 {
   background: var(--color-party-accent);
   color: var(--color-text);
  }

  .status-調査・検討中 {
   background: var(--color-text-subtle);
   color: white;
  }

  .status-対応中 {
   background: var(--color-success);
   color: white;
  }

  .status-対応完了 {
   background: var(--color-success);
   color: white;
}

  .category-tag {
    background: var(--color-party-accent);
    color: var(--color-text);
  }

  .area-tag {
    background: var(--color-background-subtle);
    color: var(--color-text);
  }

  .opinion-text {
    margin: 0;
    line-height: 1.8;
    white-space: pre-wrap;
  }

  .summary-box {
    margin-top: 1.25rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--color-background-subtle);
  }

  .summary-box p {
    margin: 0.4rem 0 0;
    line-height: 1.6;
  }

  .empty-state {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-text-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
      gap: 0.3rem;
    }

    .opinion-card {
      padding: 1.2rem;
    }
  }
  
  .response-box {
  margin-top: 1rem;
  padding: 1rem;
  border-left: 4px solid var(--color-party-primary);
  background: var(--color-background-subtle);
  border-radius: var(--radius-sm);
  }

  .response-box strong {
  display: block;
  margin-bottom: 0.4rem;
  color: var(--color-party-primary);
  }

  .response-box p {
  margin: 0;
  }
  .policy-link-box {
  margin-top: 1.2rem;
}

.policy-link-box a {
  display: inline-block;
  padding: 0.6rem 1rem;
  border-radius: var(--radius-md);
  background: var(--color-party-primary);
  color: white;
  text-decoration: none;
  font-weight: 600;
}

.policy-link-box a:hover {
  opacity: 0.8;
}
  </style>

<script>
  const filterButtons =
    document.querySelectorAll<HTMLButtonElement>('.filter-btn');

  const opinionCards =
    document.querySelectorAll<HTMLElement>('.opinion-card');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedCategory =
        button.dataset.category;

      filterButtons.forEach((btn) => {
        btn.classList.remove('active');
      });

      button.classList.add('active');

      opinionCards.forEach((card) => {
        if (
          selectedCategory === 'all' ||
          card.dataset.category === selectedCategory
        ) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
