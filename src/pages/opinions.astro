---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// ★取得したスプレッドシートの「ウェブに公開(CSV)」URLをここに貼り付け
const CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSU7oB98Tjzj_eMaZFfoRX9H8QlDtxPCXtb3OfgNZzYRQ3y79z23U88vALTaHFWGQEm75CGlSbo6Gk1/pub?output=csv";

interface Opinion {
  date: string;
  categoryInput: string;
  area: string;
  text: string;
  category: string;
  policyId: string;
  status: string;
  summary: string;
  isPublic: boolean;
}

let opinions: Opinion[] = [];

try {
  const res = await fetch(CSV_URL);
  if (res.ok) {
    const csvText = await res.text();
    // CSVパース（ヘッダー行を除外）
    const lines = csvText.split('\n').slice(1);
    
    opinions = lines.map(line => {
      const cols = line.split(',').map(c => c.replace(/^"|"$/g, '').trim());
      return {
        date: cols[0] || '',
        categoryInput: cols[1] || '',
        area: cols[2] || '高槻市内',
        text: cols[3] || '',
        category: cols[4] || 'その他',
        policyId: cols[5] || 'policy-other',
        status: cols[6] || '受付済み',
        summary: cols[7] || '',
        isPublic: cols[8]?.toUpperCase() === 'TRUE'
      };
    }).filter(item => item.isPublic && item.text); // 公開フラグ=TRUEかつ本文があるデータのみ表示
  }
} catch (e) {
  console.error("データ取得エラー:", e);
}

// カテゴリごとの配色デザイン
const getCategoryStyle = (cat: string) => {
  switch (cat) {
    case '暮らし': return 'background: #e3f2fd; color: #0d47a1;';
    case '子育て': return 'background: #fce4ec; color: #880e4f;';
    case '医療・介護': return 'background: #e8f5e9; color: #1b5e20;';
    case '防災': return 'background: #fff3e0; color: #e65100;';
    default: return 'background: #f5f5f5; color: #616161;';
  }
};
---

<Layout
  title="市民の声・対応状況｜もっと住みやすい高槻へ"
  description="皆様から寄せられたお困りごとやご意見と、それに対する取り組みの対応状況を公開しています。"
>
  <Header />

  <main class="opinions-page" id="main-content" tabindex="-1">
    <section class="hero">
      <h1>💬 市民の声と対応状況</h1>
      <p>
        皆様からお寄せいただいたお困りごとやご意見は、AIによる一次処理（匿名化）と確認を経た上で公開し、政策提案や地域改善に活用しています。
      </p>
    </section>

    <!-- 意見一覧リスト -->
    <div class="opinions-list">
      {opinions.length === 0 ? (
        <div class="empty-state">
          現在、表示できるご意見・ご要望はありません。
        </div>
      ) : (
        opinions.map(item => (
          <article class="opinion-card">
            <!-- ステータス・カテゴリ・地域タグ -->
            <div class="card-tags">
              <span class="status-tag">
                {item.status}
              </span>
              <span class="category-tag" style={getCategoryStyle(item.category)}>
                {item.category}
              </span>
              <span class="area-tag">📍 {item.area}</span>
            </div>

            <!-- 本文 -->
            <p class="opinion-text">
              {item.text}
            </p>

            <!-- AI要約メモ -->
            {item.summary && (
              <div class="summary-box">
                💡 <strong>ポイント:</strong> {item.summary}
              </div>
            )}
          </article>
        ))
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
.opinions-page {
  max-width: 900px;
  margin: 0 auto;
  padding: 4rem 2rem;
}

.hero {
  text-align: center;
  margin-bottom: 3rem;
}

.hero h1 {
  color: #003f88;
  margin-bottom: 1rem;
}

.hero p {
  color: #555;
  line-height: 1.6;
}

.opinions-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.empty-state {
  border: 1px solid #ddd;
  border-radius: 16px;
  padding: 3rem 2rem;
  text-align: center;
  background: #fff;
  color: #666;
}

.opinion-card {
  border: 1px solid #ddd;
  border-radius: 16px;
  padding: 2rem;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
}

.card-tags {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
  align-items: center;
  flex-wrap: wrap;
}

.status-tag {
  background: #003f88;
  color: #fff;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: bold;
}

.category-tag {
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: bold;
}

.area-tag {
  color: #666;
  font-size: 0.85rem;
}

.opinion-text {
  font-size: 1.05rem;
  line-height: 1.6;
  color: #2b2b2b;
  margin-bottom: 1rem;
  white-space: pre-wrap;
}

.summary-box {
  background: #f0f7ff;
  border-left: 4px solid #003f88;
  padding: 0.75rem 1rem;
  border-radius: 0 8px 8px 0;
  font-size: 0.9rem;
  color: #333;
}
</style>