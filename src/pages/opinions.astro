---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Googleスプレッドシート「公開データ」のCSV URL
const CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSU7oB98Tjzj_eMaZFfoRX9H8QlDtxPCXtb3OfgNZzYRQ3y79z23U88vALTaHFWGQEm75CGlSbo6Gk1/pub?gid=329717834&single=true&output=csv";
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;

interface Opinion {
  id: string;
  date: string;
  categoryInput: string;
  area: string;
  text: string;
  category: string;
  policyId: string;
  status: string;
  summary: string;
  comment: string;
  policyReview: string;
  policyMemo: string;
  isPublic: boolean;
}

function getStatusIcon(status: string) {
  switch (status) {
    case "受付済み":
      return "📩";

    case "確認中":
      return "🔎";

    case "調査・検討中":
      return "📝";

    case "対応中":
      return "🔧";

    case "対応完了":
      return "✅";

    case "対応困難":
      return "⚠️";

    default:
      return "📌";
  }
}



let opinions: Opinion[] = [];

// CSVを正しく読み込むための簡易パーサー
function parseCSVLine(line: string): string[] {
  const result: string[] = [];
  let current = '';
  let inQuotes = false;

  for (let i = 0; i < line.length; i++) {
    const char = line[i];

    if (char === '"') {
      if (inQuotes && line[i + 1] === '"') {
        current += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
    } else if (char === ',' && !inQuotes) {
      result.push(current.trim());
      current = '';
    } else {
      current += char;
    }
  }

  result.push(current.trim());

  return result;
}

try {
  const res = await fetch(CSV_URL);

  if (res.ok) {
    const csvText = await res.text();

    const lines = csvText
      .split(/\r?\n/)
      .filter(line => line.trim() !== '');

    // 1行目はヘッダー
    opinions = lines
      .slice(1)
      .map(line => {
        const cols = parseCSVLine(line);

        return {
         id: cols[0] || '',
         date: cols[1] || '',
         categoryInput: cols[2] || '',
         area: cols[3] || '高槻市内',
         text: cols[4] || '',
         category: cols[5] || 'その他',
         policyId: cols[6] || '',
         status: cols[7] || '受付済み',
         summary: cols[8] || '',
         comment: cols[9] || '',
         isPublic: cols[10]?.toUpperCase() === 'TRUE',
         policyReview: cols[11] || '未検討',
         policyMemo: cols[12] || ''
        };
      })
      .filter(item => item.isPublic && item.text);
  }
} catch (e) {
  console.error('市民の声データ取得エラー:', e);
}
---

<Layout
  title="市民の声・対応状況｜もっと住みやすい高槻へ"
  description="皆様から寄せられたお困りごとやご意見と、それに対する取り組みの対応状況を公開しています。"
>

  <Header />

  <main>
    <section class="hero">
      <h1>市民の声・対応状況</h1>

      <p>
        皆様から寄せられた高槻市でのお困りごとやご意見と、
        それに対する取り組みの対応状況を公開しています。
      </p>
    </section>

    <section class="opinions-section">
     <h2>市民の声</h2>
        <div class="rules-notice">
          <p>ご意見を送る前に、市民の声の運用ルールをご確認ください。</p>
          <a href={`${base}opinions/rules/`} class="rules-link">
            市民の声の運用ルールを確認する
          </a>
        </div>

      <!-- カテゴリフィルター -->
      <div class="category-filter">
        <button type="button" data-category="all" class="filter-btn active">
         すべて
        </button>

        <button type="button" data-category="暮らし" class="filter-btn">
         暮らし
        </button>

        <button type="button" data-category="医療・介護" class="filter-btn">
         医療・介護
        </button>

        <button type="button" data-category="防災" class="filter-btn">
         防災
        </button>

        <button type="button" data-category="子育て" class="filter-btn">
         子育て
        </button>

        <button type="button" data-category="その他" class="filter-btn">
         その他
        </button>
      </div>

      {opinions.length === 0 ? (
        <div class="empty-state">
          現在、表示できるご意見・ご要望はありません。
        </div>
      ) : (
        <div class="opinions-list">
          {opinions.map(item => (
            <article
              class="opinion-card"
              data-category={item.category}
            >

              <div class="card-header">
                <span class="opinion-id">
                  {item.id}
                </span>

                <span class="date">
                  {item.date}
                </span>
              </div>

              <div class="card-tags">
                <span class={`status-tag status-${item.status}`}>
                  {getStatusIcon(item.status)}
                  {item.status}
                </span>

                <span class="category-tag">
                  {item.category}
                </span>

                <span class="area-tag">
                  📍 {item.area}
                </span>
              </div>

              <p class="opinion-text">
                {item.text}
              </p>

              {item.summary && (
                <div class="summary-box">
                  💡 <strong>ポイント:</strong> {item.summary}
                </div>
              )}

              {item.comment && (
                <div class="response-box">
                 <strong>📢 対応状況</strong>
                 <p>{item.comment}</p>
                </div>
              )}

              {item.policyReview === '政策化' && item.policyId && (
                <div class="policy-link-box">
                  <a href={`${base}policy/${item.policyId}`}>
                   🔗 関連する政策を見る
                  </a>
                </div>
              )}

            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .hero {
    padding: clamp(2rem, 4vw, 3rem) 0 0;
    text-align: center;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .hero p {
    line-height: 1.8;
  }

  .opinions-section {
    width: min(100% - 2rem, var(--container-width));
    max-width: var(--container-width);
    margin-inline: auto;
    padding: 0 0 4rem;
  }

  .opinions-section h2 {
    margin-bottom: 1.5rem;
  }

  .opinions-list {
    display: grid;
    gap: 1.5rem;
  }

  .category-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: 2rem;
}

.filter-btn {
  padding: 0.55rem 1rem;
  border: 1px solid #ccc;
  border-radius: 999px;
  background: #fff;
  color: #333;
  cursor: pointer;
  font-size: 0.95rem;
}

.filter-btn:hover {
  opacity: 0.8;
}

.filter-btn.active {
  background: #003f88;
  color: #fff;
  border-color: #003f88;
}

  .opinion-card {
    padding: 1.5rem;
    border: 1px solid #ddd;
    border-radius: 12px;
    background: #fff;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: #666;
    font-size: 0.85rem;
  }

  .opinion-id {
    font-weight: 600;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .card-tags span {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
  }

  .status-受付済み {
   background: #003f88;
   color: white;
 }

  .rules-notice {
    margin: 0 0 2rem;
    padding: 1.5rem;
    border: 1px solid #d7e4f2;
    border-radius: 8px;
    background: #f8fbff;
  }

  .rules-notice p {
    margin-bottom: 1rem;
  }

  .rules-link {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border: 2px solid #003f88;
    border-radius: 8px;
    color: #003f88;
    font-weight: 700;
    text-decoration: none;
  }

  .rules-link:hover {
    background: #003f88;
    color: #fff;
  }

  .status-確認中 {
   background: #fabe00;
   color: #222;
  }

  .status-調査・検討中 {
   background: #6c757d;
   color: white;
  }

  .status-対応中 {
   background: #198754;
   color: white;
  }

  .status-対応完了 {
   background: #28a745;
   color: white;
}

  .category-tag {
    background: #fabe00;
    color: #222;
  }

  .area-tag {
    background: #f3f3f3;
    color: #444;
  }

  .opinion-text {
    margin: 0;
    line-height: 1.8;
    white-space: pre-wrap;
  }

  .summary-box {
    margin-top: 1.25rem;
    padding: 1rem;
    border-radius: 8px;
    background: #f7f7f7;
  }

  .summary-box p {
    margin: 0.4rem 0 0;
    line-height: 1.6;
  }

  .empty-state {
    padding: 3rem 1rem;
    text-align: center;
    color: #666;
    border: 1px solid #ddd;
    border-radius: 12px;
  }

  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
      gap: 0.3rem;
    }

    .opinion-card {
      padding: 1.2rem;
    }
  }
  
  .response-box {
  margin-top: 1rem;
  padding: 1rem;
  border-left: 4px solid #003f88;
  background: #f5f7fa;
  border-radius: 6px;
  }

  .response-box strong {
  display: block;
  margin-bottom: 0.4rem;
  color: #003f88;
  }

  .response-box p {
  margin: 0;
  }
  .policy-link-box {
  margin-top: 1.2rem;
}

.policy-link-box a {
  display: inline-block;
  padding: 0.6rem 1rem;
  border-radius: 8px;
  background: #003f88;
  color: white;
  text-decoration: none;
  font-weight: 600;
}

.policy-link-box a:hover {
  opacity: 0.8;
}
  </style>

<script>
  const filterButtons =
    document.querySelectorAll<HTMLButtonElement>('.filter-btn');

  const opinionCards =
    document.querySelectorAll<HTMLElement>('.opinion-card');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedCategory =
        button.dataset.category;

      filterButtons.forEach((btn) => {
        btn.classList.remove('active');
      });

      button.classList.add('active');

      opinionCards.forEach((card) => {
        if (
          selectedCategory === 'all' ||
          card.dataset.category === selectedCategory
        ) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>