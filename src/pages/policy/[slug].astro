---
import { getCollection } from "astro:content";
import { getPolicy } from "../../lib/getPolicy";
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PolicyHero from '../../components/policy/PolicyHero.astro';
import ReferenceList from "../../components/policy/ReferenceList.astro";
import PolicySection from "../../components/PolicySection.astro";
import EvidenceBox from "../../components/EvidenceBox.astro";
import ProposalList from "../../components/policy/ProposalList.astro";
import YouTubeLink from "../../components/policy/YouTubeLink.astro";
import { getBaseUrl } from "../../lib/siteUrl";
import {
  resolveDisplayMode,
  shouldShowDetail,
} from "../../data/policyDisplay";

const { slug } = Astro.params;
const base = getBaseUrl();

const {
  content: data,
  relatedActivities,
  references,
} = await getPolicy(slug as string);

// 詳細表示の判定（開発時は常に詳細表示、本番は policyDisplay.ts の設定に従う）
const showDetail = shouldShowDetail(data.detailRelease);
const isDev = import.meta.env.DEV;
const prodDisplayMode = resolveDisplayMode(data.detailRelease);


export async function getStaticPaths() {
  const policies = await getCollection('policies', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  return policies.map((policy) => ({
    params: { slug: policy.id.replace(/\.md$/, '') },
    props: { policy },
  }));
}
---

<Layout
  title={`${data.title || '政策詳細'}｜もっと住みやすい高槻へ`}
  description={data.description || ''}
  policyCategory={data.category}
>
  <Header />

  <main class="policy-detail page-content" id="main-content" tabindex="-1">
    <PolicyHero
      title={data.heroTitle || data.title || ''}
      description={data.heroDescription || data.description || ''}
      updated={data.updated}
    />

    {/* 開発時のみ表示される注意書き（本番のHTMLには出力されない） */}
    {isDev && (
      <p class="dev-badge" role="note">
        【開発表示】npm run dev では常に詳細を表示しています。
        本番ではこの政策は「{prodDisplayMode === "full" ? "詳細" : "概要"}」表示になります。
        本番の見え方は npm run build → npm run preview で確認してください。
      </p>
    )}

    {/* ① 問題提起 */}
    {data.problem?.paragraphs && (
      <PolicySection title="問題提起" icon="📍">
        <ul class="policy-list">
          {data.problem.paragraphs.map((paragraph: string) => (
            <li>{paragraph}</li>
          ))}
        </ul>
      </PolicySection>
    )}

    {/* ① 評価 (主観 / 客観) ※概要版では表示しない */}
    {(showDetail || data.evaluation?.subjective?.paragraphs) && data.evaluation && (
      <PolicySection title="評価" icon="📊">
        {/* 主観的評価 */}
        {data.evaluation.subjective?.paragraphs && (
          <EvidenceBox type="subjective">
            {data.evaluation.subjective.heading && <h3>{data.evaluation.subjective.heading}</h3>}
            <ul class="policy-list">
              {data.evaluation.subjective.paragraphs.map((paragraph: string) => (
                <li>{paragraph}</li>
              ))}
            </ul>
          </EvidenceBox>
        )}

        {/* 客観的評価 */}
        {showDetail && data.evaluation.objective?.paragraphs && (
          <EvidenceBox type="objective">
            {data.evaluation.objective.heading && <h3>{data.evaluation.objective.heading}</h3>}
            <ul class="policy-list">
              {data.evaluation.objective.paragraphs.map((paragraph: string) => (
                <li>{paragraph}</li>
              ))}
            </ul>
          </EvidenceBox>
        )}
      </PolicySection>
    )}

    {/* ①＆③ 課題抽出 (PolicySection化 ＋ ul/liリスト化) */}
    {data.issues && data.issues.length > 0 && (
      <PolicySection title="課題抽出" icon="⚠️">
        <div class="issue-grid">
          {data.issues.map((issue) => (
            <article class="issue-card">
              {issue?.title && (
                <h3>{issue.title}</h3>
              )}

              {/* 課題の説明文は概要版でも表示する（問題の分析は公開し、対策の設計は詳細に残す） */}
              {issue?.description && (
                <p>{issue.description}</p>
              )}
            </article>
          ))}

        </div>

      </PolicySection>
    )}

    {/* この政策で取り組むこと */}
    {showDetail && data.proposals && data.proposals.length > 0 && (
      <PolicySection title="この政策で取り組むこと" icon="✅">
        {data.proposals.map((proposal) => (
          <div class="proposal-card">
            {proposal.heading && (
              <h3>{proposal.heading}</h3>
            )}
            {/* 提案の具体的な項目は詳細のみ（概要版では見出しだけ出す） */}
            {showDetail && proposal.items && (
              <ProposalList items={proposal.items} />
            )}
          </div>
        ))}
      </PolicySection>
    )}

    {/* 概要版のときだけ出す案内（詳細では表示しない） */}
    {!showDetail && (
      <PolicySection title="ご意見をお聞かせください" icon="✉️">
        <p>
          具体的な提案は、根拠と実現可能性を確認しながら、いま磨き上げているところです。
          この課題について現場で感じていることやご意見があれば、ぜひお寄せください。
          いただいた声は、提案をより良いものにするための大切な材料になります。
        </p>
        <p class="policy-cta">
          <a
            href={`${base}opinions/rules/`}
            class="btn btn-primary"
            onclick="gtag('event', 'click_opinion_form', { link_location: 'policy_summary' })"
          >
            市民の声を送る
          </a>
        </p>
      </PolicySection>
    )}

    {/* ①＆② 政策の限界 (PolicySection化 ＋ EvidenceBox化) ※概要版では表示しない */}
    {showDetail && data.limitations?.paragraphs && (
      <PolicySection title="政策の限界" icon="⚖️">
        <EvidenceBox type="limitation">
          <ul class="policy-list">
            {data.limitations.paragraphs.map((paragraph: string) => (
              <li>{paragraph}</li>
            ))}
          </ul>
        </EvidenceBox>
      </PolicySection>
    )}

    {/* YouTube */}
      {data.youtube && (
        <YouTubeLink
         title={data.youtube.title}
         url={data.youtube.url}
        />
      )}

    {/* 参考資料 ※概要版では表示しない */}
    {showDetail && <ReferenceList sources={references} />}

  </main>

  <Footer />
</Layout>

<style>
/* 開発時のみ表示される注意書き */
.dev-badge {
  max-width: 720px;
  margin: 0 auto 1.5rem;
  padding: 0.75rem 1rem;
  background: #fff8e1;
  border: 1px solid var(--color-party-accent);
  border-radius: var(--radius);
  font-size: 0.85rem;
  line-height: 1.7;
  color: var(--color-text);
}

/* 課題抽出リストのスタイル調整 */
.issue-grid {
  display: grid;
  gap: 1rem;
}

.issue-card {

  padding: 1.25rem 1.5rem;

  background: var(--color-background-subtle);

  border: 1px solid var(--color-border-strong);

  border-radius: var(--radius);

}

.issue-card h3 {

  margin: 0 0 0.6rem;

  color: var(--color-party-primary);

  font-size: 1.1rem;

}

.issue-card p {

  margin: 0;

  line-height: 1.75;

  color: var(--color-text-muted);

}

/* 政策提案カード */

.proposal-card {

  padding: 1.25rem 1.5rem;

  margin-bottom: 1rem;

  background: var(--color-background-subtle);

  border: 1px solid var(--color-border-strong);

  border-radius: var(--radius);

}


.proposal-card:last-child {

  margin-bottom: 0;

}


.proposal-card h3 {

  margin: 0 0 0.8rem;

  color: var(--color-party-primary);

  font-size: 1.1rem;

  font-weight: 700;

}


.proposal-card ul {

  margin: 0;

  padding-left: 1.25rem;

}


.proposal-card li {

  margin-bottom: 0.5rem;

  line-height: 1.7;

}


.proposal-card li:last-child {

  margin-bottom: 0;

}

/* 概要版の案内セクション内のボタン */
.policy-cta {
  margin-top: 1.25rem;
}

/* 政策セクションのリスト（問題提起・評価・限界など） */
.policy-list {
  margin-top: var(--space-sm);
  margin-bottom: var(--space-md);
  padding-left: 1.25rem;
}

.policy-list li {
  line-height: 1.7;
  margin-bottom: 0.5rem;
}

.policy-list li:last-child {
  margin-bottom: 0;
}
</style>