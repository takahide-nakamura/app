---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PolicyHero from '../../components/policy/PolicyHero.astro';
import RelatedActivities from "../../components/policy/RelatedActivities.astro";
import { sources } from "../../data/sources";
import ReferenceList from "../../components/policy/ReferenceList.astro";
import PolicySection from "../../components/PolicySection.astro";
import EvidenceBox from "../../components/EvidenceBox.astro";
import ProposalList from "../../components/policy/ProposalList.astro";

const { policy } = Astro.props;
const data = policy?.data || {};
const allActivities = await getCollection("activities");

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((policy) => ({
    params: { slug: policy.id.replace(/\.md$/, '') },
    props: { policy },
  }));
}

const relatedActivities =
  data.relatedActivities
    ? allActivities
        .filter((activity) =>
          data.relatedActivities.includes(activity.id)
        )
        .map((activity) => ({
          title: activity.data.title,
          summary: activity.data.summary,
          href: `/activity/${activity.id}/`,
        }))
    : [];
const references =
  data.references
    ? data.references
        .map((id: string) => sources[id as keyof typeof sources])
        .filter(Boolean)
    : [];
---

<Layout
  title={`${data.title || '政策詳細'}｜もっと住みやすい高槻へ`}
  description={data.description || ''}
>
  <Header />

  <main class="policy-detail container">
    <PolicyHero
      title={data.heroTitle || data.title || ''}
      description={data.heroDescription || data.description || ''}
      updated={data.updated}
    />

    {/* ① 問題提起 */}
    {data.problem?.paragraphs && (
      <PolicySection title="問題提起" icon="📍">
        {data.problem.paragraphs.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </PolicySection>
    )}

    {/* ① 評価 (主観 / 客観) */}
    {data.evaluation && (
      <PolicySection title="評価" icon="📊">
        {/* 主観的評価 */}
        {data.evaluation.subjective?.paragraphs && (
          <EvidenceBox type="subjective">
            {data.evaluation.subjective.heading && <h3>{data.evaluation.subjective.heading}</h3>}
            {data.evaluation.subjective.paragraphs.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </EvidenceBox>
        )}

        {/* 客観的評価 */}
        {data.evaluation.objective?.paragraphs && (
          <EvidenceBox type="objective">
            {data.evaluation.objective.heading && <h3>{data.evaluation.objective.heading}</h3>}
            {data.evaluation.objective.paragraphs.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </EvidenceBox>
        )}
      </PolicySection>
    )}

    {/* ①＆③ 課題抽出 (PolicySection化 ＋ ul/liリスト化) */}
    {data.issues && data.issues.length > 0 && (
      <PolicySection title="課題抽出" icon="⚠️">
        <div class="issue-grid">
          {data.issues.map((issue: any) => (
            <article class="issue-card">
              {issue?.title && (
                <h3>{issue.title}</h3>
              )}
              
              {issue?.description && (
                <p>{issue.description}</p>
              )}
            </article>
          ))}

        </div>

      </PolicySection>
    )}

    {/* ①＆④ 政策提案 (PolicySection化 ＋ div.proposal-cardで不要な余白を防止) */}
    {data.proposals && data.proposals.length > 0 && (
      <PolicySection title="政策提案" icon="✅">
        {data.proposals.map((proposal: any) => (
          <div class="proposal-card">
            {proposal.heading && (
              <h3>{proposal.heading}</h3>
            )}
            {proposal.items && (
              <ProposalList items={proposal.items} />
            )}
          </div>
        ))}
      </PolicySection>
    )}

    {/* ①＆② 政策の限界 (PolicySection化 ＋ EvidenceBox化) */}
    {data.limitations?.paragraphs && (
      <PolicySection title="政策の限界" icon="⚖️">
        <EvidenceBox type="limitation">
          {data.limitations.paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </EvidenceBox>
      </PolicySection>
    )}

    {/* 関連する活動 */}
    <RelatedActivities activities={relatedActivities} />

    {/* 参考資料 */}
    <ReferenceList sources={references} />

  </main>

  <Footer />
</Layout>

<style>
/* 課題抽出リストのスタイル調整 */
.issue-grid {
  display: grid;
  gap: 1rem;
}

.issue-card {

  padding: 1.25rem 1.5rem;

  background: #f8fafc;

  border: 1px solid #e2e8f0;

  border-radius: 10px;

}

.issue-card h3 {

  margin: 0 0 0.6rem;

  color: var(--color-primary, #003f88);

  font-size: 1.1rem;

}

.issue-card p {

  margin: 0;

  line-height: 1.75;

  color: #444;

}

/* 政策提案カード */

.proposal-card {

  padding: 1.25rem 1.5rem;

  margin-bottom: 1rem;

  background: #f8fafc;

  border: 1px solid #e2e8f0;

  border-radius: 10px;

}


.proposal-card:last-child {

  margin-bottom: 0;

}


.proposal-card h3 {

  margin: 0 0 0.8rem;

  color: var(--color-primary, #003f88);

  font-size: 1.1rem;

  font-weight: 700;

}


.proposal-card ul {

  margin: 0;

  padding-left: 1.25rem;

}


.proposal-card li {

  margin-bottom: 0.5rem;

  line-height: 1.7;

}


.proposal-card li:last-child {

  margin-bottom: 0;

}
</style>