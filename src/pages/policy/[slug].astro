---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PolicyHero from '../../components/policy/PolicyHero.astro';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((policy) => ({
    params: { slug: policy.id.replace(/\.md$/, '') },
    props: { policy },
  }));
}

const { policy } = Astro.props;
const data = policy?.data || {};
---

<Layout
  title={`${data.title || '政策詳細'}｜もっと住みやすい高槻へ`}
  description={data.description || ''}
>
  <Header />

  <main class="policy-detail container">
    <PolicyHero
      title={data.heroTitle || data.title || ''}
      description={data.heroDescription || data.description || ''}
      updated={data.updated}
    />

    {/* 問題提起 */}
    {data.problem?.paragraphs && (
      <section class="policy-section">
        <h2>📍 問題提起</h2>
        {data.problem.paragraphs.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </section>
    )}

    {/* 評価 (主観 / 客観) */}
    {data.evaluation && (
      <section class="policy-section">
        <h2>評価</h2>
        
        {/* 主観的評価 */}
        {data.evaluation.subjective?.paragraphs && (
          <div class="evaluation-block">
            {data.evaluation.subjective.heading && <h3>{data.evaluation.subjective.heading}</h3>}
            {data.evaluation.subjective.paragraphs.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        {/* 客観的評価 */}
        {data.evaluation.objective?.paragraphs && (
          <div class="evaluation-block">
            {data.evaluation.objective.heading && <h3>{data.evaluation.objective.heading}</h3>}
            {data.evaluation.objective.paragraphs.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}
      </section>
    )}

    {/* 課題抽出 */}
    {data.issues && data.issues.length > 0 && (
      <section class="policy-section">
        <h2>⚠️ 課題抽出</h2>
        {data.issues.map((issue: any) => (
          <div class="issue-card">
            {issue?.title && <h3>{issue.title}</h3>}
            {issue?.description && <p>{issue.description}</p>}
            {issue?.paragraphs?.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ))}
      </section>
    )}

    {/* 政策提案 */}
    {data.proposals && data.proposals.length > 0 && (
      <section class="policy-section">
        <h2>✅ 政策提案</h2>
        {data.proposals.map((proposal: any) => (
          <div class="proposal-card">
            {proposal?.title && <h3>{proposal.title}</h3>}
            {proposal?.description && <p>{proposal.description}</p>}
            {proposal?.paragraphs?.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ))}
      </section>
    )}
  </main>

  <Footer />
</Layout>