---
import PolicyDetailLayout from '../../components/PolicyDetailLayout.astro';
import PolicySection from '../../components/PolicySection.astro';
import EvidenceBox from '../../components/EvidenceBox.astro';
import ProposalList from "../../components/policy/ProposalList.astro";
import { sources } from '../../data/sources';
import { activities } from '../../data/activities';
import PolicyHero from '../../components/policy/PolicyHero.astro';
import RelatedActivities from '../../components/policy/RelatedActivities.astro';
import ReferenceList from '../../components/policy/ReferenceList.astro';

const relatedActivities = activities.filter(
  (activity) => activity.id === "nursing-care-visit"
);

---

<PolicyDetailLayout
  title="騒音対策｜政策｜もっと住みやすい高槻へ"
  description="高槻市の騒音問題について、公開資料と市民生活の視点から課題・提案・期待される効果をまとめています。"
>

    <PolicyHero
     title="生活騒音対策"
     description="深夜の騒音や集合住宅での生活騒音などを改善し、市民が安心して暮らせる静かな生活環境を目指します。"
    />

    <PolicySection title="現状の課題">
        <p>
            深夜の爆音や集合住宅での生活騒音は、多くの市民が睡眠不足やストレスを感じる原因となっています。安心して暮らせる生活環境を守るためには、生活騒音への対策が重要です。
        </p>
        

    </PolicySection>

    <PolicySection title="なぜ重要なのか">

             <p>
                生活騒音は、単なる「うるささ」の問題ではありません。
            </p>
            
            <p>
                深夜の爆音バイクや改造車、集合住宅での生活騒音などは、睡眠不足や慢性的なストレスを引き起こし、市民の健康や生活の質（QOL）へ大きな影響を与えます。
            </p>

            <p>
                安心して眠り、安心して暮らせる生活環境を守ることは、市民の健康を守ることにもつながります。
            </p>

        <EvidenceBox title="🟢 現場から見えること" type="field">
            <p>
                私は理学療法士として、睡眠不足や慢性的なストレスが身体機能や心身の健康へ与える影響を数多く見てきました。
            </p>
            
            <p>
                十分な睡眠は、子どもの成長、高齢者の健康維持、働く世代の疲労回復など、あらゆる世代の健康に欠かせません。
            </p>

            <p>
                世界保健機関（WHO）も環境騒音は睡眠障害や循環器疾患など様々な健康影響と関連すると示しており、生活騒音対策は公衆衛生の観点からも重要な課題です。
            </p>


        </EvidenceBox>
    </PolicySection>

    <PolicySection title="現状">

        <EvidenceBox title="🔵 現状" type="official">

            <p>
                工場や事業場には騒音規制法などによる基準があります。
            </p>

            <p>
                一方、市民から多く寄せられる生活騒音は、深夜の爆音バイクや改造車、集合住宅での騒音など多岐にわたります。
            </p>

            <p>
                生活騒音は発生場所や発生原因が様々であり、市民の生活環境に大きな影響を与えています。
            </p> 
            

        </EvidenceBox>

        <EvidenceBox title="🟣 制度上の課題" type="reason">

            <p>
                現在の制度は、継続的な騒音を前提としているものが多く、瞬間的な爆音や生活騒音には十分対応しにくい場面があります。
            </p>

            <p>
                また、集合住宅では管理組合・管理会社・警察など相談先が分かれており、市民にとって「どこへ相談すればよいか」が分かりにくいことも課題です。
            </p>

        </EvidenceBox>

        <EvidenceBox title="🟡 改善の余地"  type="improvement">

            <p>
                生活騒音対策は、市が主体となって改善できる余地があります。
            </p>

            <p>
                生活騒音対策ガイドラインの整備、相談体制の充実、管理組合への情報提供、警察との連携強化などを進めることで、市民が安心して暮らせる生活環境づくりにつながります。
            </p>

        </EvidenceBox>

    </PolicySection>

    <PolicySection title="私の提案">

        <ProposalList
            items={[
             "ごみ出しルールを分かりやすく伝える情報発信を充実させます。",
             "高齢者や身体が不自由な方へのごみ出し支援を推進します。",
             "不法投棄を防ぐため、地域・行政・関係機関が連携した対策を進めます。",
             "地域の実情に応じた集積所の環境改善を進めます。",
             "市民の声を継続的に把握し、ごみ行政の改善につなげます。"
           ]}
        />

    </PolicySection>
    
    <PolicySection title="期待される効果">

        <EvidenceBox title="🌱 この政策で目指すこと" type="effect">

            <ul>

                <li>ごみ出しルールが分かりやすくなる</li>

                <li>地域の生活環境や景観の向上につながる</li>

                <li>高齢者なども安心してごみ出しができる環境づくりにつながる</li>

                <li>地域全体でごみ問題に取り組む意識が高まる</li>
                
            </ul>

        </EvidenceBox>

        <h3>私が大切にしたいこと</h3>
           <p>
                ごみ問題は行政だけで解決できるものではありません。
            </p>
            
            <p>
                市民・地域・行政が協力し、それぞれができることを積み重ねることで、より住みやすいまちづくりにつながると考えています。
            </p>
            
            <p>
                「きれいなまち」は、多くの市民が安心して暮らせるまちにつながります。そのため、一人ひとりが参加しやすい仕組みづくりを大切にしていきます。
            </p>

    </PolicySection>

    

    <RelatedActivities
     activities={relatedActivities}
    />

    <ReferenceList
        sources={[
         sources.garbageGuide,
         sources.garbagePage
        ]}
    />
    
</PolicyDetailLayout>
