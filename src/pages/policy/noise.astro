---
import PolicyDetailLayout from "../../components/PolicyDetailLayout.astro";
import PolicyHero from "../../components/policy/PolicyHero.astro";
import PolicySection from "../../components/PolicySection.astro";
import EvidenceBox from "../../components/EvidenceBox.astro";
import ProposalList from "../../components/policy/ProposalList.astro";
import RelatedActivities from "../../components/policy/RelatedActivities.astro";
import ReferenceList from "../../components/policy/ReferenceList.astro";

import { getPolicy } from "../../lib/getPolicy";

const { content, relatedActivities, references } = await getPolicy("noise");
---

<PolicyDetailLayout
  title={`${content.title}｜政策｜もっと住みやすい高槻へ`}
  description={content.description}
>
  <PolicyHero
    title={content.heroTitle}
    description={content.heroDescription}
    updated={content.updated}
  />

  <PolicySection title="問題提起" icon="📍">
    {content.problem.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </PolicySection>

  <PolicySection title="評価" icon="📊">
    <h3>{content.evaluation.subjective.heading}</h3>
    <EvidenceBox type="subjective">
      {content.evaluation.subjective.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </EvidenceBox>

    <h3>{content.evaluation.objective.heading}</h3>
    <EvidenceBox type="objective">
      {content.evaluation.objective.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </EvidenceBox>
  </PolicySection>

  <PolicySection title="課題抽出" icon="⚠️">
    <ul>
      {content.issues.map((issue) => (
        <li>
          <strong>{issue.title}</strong><br />
          {issue.description}
        </li>
      ))}
    </ul>
  </PolicySection>

  <PolicySection title="政策提案" icon="✅">
    {content.proposals.map((proposal) => (
      <section>
        <h3>{proposal.heading}</h3>
        <ProposalList items={proposal.items} />
      </section>
    ))}
  </PolicySection>

  <PolicySection title="政策の限界" icon="⚖️">
    <EvidenceBox type="limitation">
      {content.limitations.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </EvidenceBox>
  </PolicySection>

  <RelatedActivities activities={relatedActivities} />

  <ReferenceList sources={references} />
</PolicyDetailLayout>