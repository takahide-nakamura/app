---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OpinionSubmission from '../../components/OpinionSubmission.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'opinions-rules');
if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title}｜もっと住みやすい高槻へ`}
  description="市民の声をどのように受け付け、整理し、政策につなげ、公開するかを定めた運用ルールです。"
>
  <Header />

  <main class="opinion-rules-page page-content" id="main-content" tabindex="-1">
    <div class="content-inner">
      <div class="rules-intro" aria-labelledby="rules-intro-heading">
        <p id="rules-intro-heading" class="rules-intro-heading">送信前に特にご確認ください</p>
        <ul>
          <li>匿名で投稿できます。</li>
          <li>AIによる整理を補助的に利用します。</li>
          <li>AIだけで自動公開することはありません。</li>
          <li>公開前に人による確認を行います。</li>
          <li>投稿内容は匿名化・整理・要約する場合があります。</li>
          <li>投稿した意見が必ず政策として実現するわけではありません。</li>
          <li>緊急通報等の窓口ではありません。</li>
        </ul>
      </div>
      <section class="terms-box" tabindex="0" aria-label="市民の声の運用ルール本文">
        <div class="rules-markdown">
          <Content />
        </div>
      </section>
      <OpinionSubmission />
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  .opinion-rules-page .content-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) 1.5rem;
    line-height: 1.8;
    color: #333;
  }

  .opinion-rules-page h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    color: #003f88;
    margin-bottom: 2rem;
    text-align: center;
    border-bottom: 3px solid #003f88;
    padding-bottom: 1rem;
  }

  .opinion-rules-page .rules-intro {
    margin: 0 0 2.5rem;
    padding: 1.25rem 1.5rem 0.75rem;
    border: 2px solid #fabe00;
    border-radius: 8px;
    background: #fffdf2;
  }

  .opinion-rules-page .rules-intro-heading {
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
  }

  .opinion-rules-page .rules-intro ul {
    margin-bottom: 0.5rem;
  }

  .opinion-rules-page h2 {
    font-size: clamp(1.3rem, 4vw, 1.8rem);
    color: #003f88;
    margin: 3rem 0 1.5rem;
    border-left: 6px solid #003f88;
    padding: 0.5rem 0 0.5rem 1rem;
    background: #f8fbff;
  }

  .opinion-rules-page .terms-box {
    margin: 2rem 0 0;
    border: 2px solid #003f88;
    border-radius: 8px;
    background: #fff;
    max-height: min(70vh, 720px);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .opinion-rules-page .terms-box:focus-visible {
    outline: 3px solid #fabe00;
    outline-offset: 3px;
  }

  .opinion-rules-page .terms-box .rules-markdown {
    padding: 1.25rem 1.5rem 0.5rem;
  }

  .opinion-rules-page h3 {
    font-size: 1.2rem;
    color: #003f88;
    margin: 2rem 0 1rem;
  }

  .opinion-rules-page p {
    margin-bottom: 1.5rem;
  }

  .opinion-rules-page ul,
  .opinion-rules-page ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .opinion-rules-page li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 600px) {
    .opinion-rules-page .terms-box {
      max-height: 60vh;
    }

    .opinion-rules-page .terms-box .rules-markdown {
      padding: 1rem 1rem 0.25rem;
    }
  }
</style>